#define SHARED_BASE_ADDR    0x01EFF7F0
#define INTERLACED          (SHARED_BASE_ADDR + 0x00)
#define PAL_NTSC            (SHARED_BASE_ADDR + 0x01)


/*
Asset Slot / Block                Start Address (GS Words)        End Address (GS Words)
Active 320x224 Framebuffer        0x00000                         0x14FFF

-- BACKGROUNDS (9 Slots) --
Background X0 Y0 (Slot 0)         0x15000                         0x1AFFF
Background X1 Y0 (Slot 1)         0x1B000                         0x20FFF
Background X2 Y0 (Slot 2)         0x21000                         0x26FFF
Background X0 Y1 (Slot 3)         0x27000                         0x2CFFF
Background X1 Y1 (Slot 4)         0x2D000                         0x32FFF
Background X2 Y1 (Slot 5)         0x33000                         0x38FFF
Background X0 Y2 (Slot 6)         0x39000                         0x3EFFF
Background X1 Y2 (Slot 7)         0x40000                         0x45FFF
Background X2 Y2 (Slot 8)         0x46000                         0x4BFFF

-- LEVEL LAYERS (9 Slots) --
Level X0 Y0 (Slot 9)              0x4C000                         0x51FFF
Level X1 Y0 (Slot 10)             0x52000                         0x57FFF
Level X2 Y0 (Slot 11)             0x58000                         0x5DFFF
Level X0 Y1 (Slot 12)             0x5E000                         0x63FFF
Level X1 Y1 (Slot 13)             0x64000                         0x69FFF
Level X2 Y1 (Slot 14)             0x6A000                         0x6FFFF
Level X0 Y2 (Slot 15)             0x70000                         0x75FFF
Level X1 Y2 (Slot 16)             0x76000                         0x7BFFF
Level X2 Y2 (Slot 17)             0x7C000                         0x81FFF

-- HEADS UP DISPLAY (1 Slot) --
Hud X0 Y0 (Slot 18)               0x82000                         0x87FFF

-- SPRITES & ACTORS (20 Slots) --
Player 1 Sprite Sheet (Slot 19)   0x88000                        0x8DFFF
Player 2 Sprite Sheet (Slot 20)   0x8E000                        0x93FFF
Collectible Item Slot 0 (Slot 21) 0x94000                        0x99FFF
Collectible Item Slot 1 (Slot 22) 0x9A000                        0x9FFFF
Collectible Item Slot 2 (Slot 23) 0xA0000                        0xA5FFF
Collectible Item Slot 3 (Slot 24) 0xA6000                        0xABFFF
Collectible Item Slot 4 (Slot 25) 0xAC000                        0xB1FFF
Collectible Item Slot 5 (Slot 26) 0xB2000                        0xB7FFF
Collectible Item Slot 6 (Slot 27) 0xB8000                        0xBDFFF
Collectible Item Slot 7 (Slot 28) 0xBE000                        0xC3FFF
Enemy Slot 0 (Slot 29)            0xC4000                        0xC9FFF
Enemy Slot 1 (Slot 30)            0xCA000                        0xCFFFF
Enemy Slot 2 (Slot 31)            0xD0000                        0xD5FFF
Enemy Slot 3 (Slot 32)            0xD6000                        0xDBFFF
Enemy Slot 4 (Slot 33)            0xDC000                        0xE1FFF
Enemy Slot 5 (Slot 34)            0xE2000                        0xE7FFF
Enemy Slot 6 (Slot 35)            0xE8000                        0xEDFFF
Enemy Slot 7 (Slot 36)            0xEE000                        0xF3FFF
Enemy Slot 8 (Slot 37)            0xF4000                        0xF9FFF
Enemy Slot 9 (Slot 38)            0xFA000                        0xFEFFF

-- COLOR LOOKUP TABLE --
Master Palette (Swizzled CLUT)    0xFFF00                        0xFFFFF
*/

#define MASTER_CLUT_VRAM 0xFFF00

#define VRAM_BGG_BASE   0x15000
#define VRAM_LVG_BASE   0x4C000
#define VRAM_SLOT_SIZE  0x6000

#define GFX_BLOCK_W   320
#define GFX_BLOCK_H   224


GSGLOBAL *gsGlobal;
GSTEXTURE master_palette_tex;

typedef struct
{
    int bx, by;
    int valid;
}
BlockCoord;

static char screen_base_path[192];
static int screen_active = 0;

static int screen_shift_cx = 1;
static int screen_shift_cy = 1;

static BlockCoord screen_grid[3][3];

static int screen_scroll_x = 0;
static int screen_scroll_y = 0;
static int screen_pending_dx = 0;
static int screen_pending_dy = 0;

static GSTEXTURE screen_bgg_tex[9];
static GSTEXTURE screen_lvg_tex[9];
static int screen_slot_valid[9];

static int resolve_neighbor(int bx, int by, int dx, int dy, int *out_bx, int *out_by)
{
    *out_bx = bx + dx;
    *out_by = by + dy;
    return 1; /* always considered valid under the rectangular default */
}

static inline int slot_for(int shift_x, int shift_y)
{
    int mx = ((shift_x % 3) + 3) % 3;
    int my = ((shift_y % 3) + 3) % 3;
    return my * 3 + mx;
}

static void build_path(char *out, size_t out_size, int bx, int by, const char *ext)
{
    snprintf(out, out_size, "%s%d,%d.%s", screen_base_path, bx, by, ext);
}

static void *read_whole_file(const char *rel_path, size_t expected_size)
{
    FILE *fp = fopen(path_portableinator((char *)rel_path), "rb");
    if (!fp) { return NULL; }

    void *buf = malloc(expected_size);
    if (!buf) { fclose(fp); return NULL; }

    size_t got = fread(buf, 1, expected_size, fp);
    fclose(fp);

    if (got != expected_size)
    {
        free(buf);
        return NULL;
    }

    return buf;
}
