}*/



static void upload_texture(GSTEXTURE *tex, void *pixels, u32 vram_base, int slot)
{
    tex->Width    = GFX_BLOCK_W;
    tex->Height   = GFX_BLOCK_H;
    tex->PSM      = GS_PSM_T8;
    tex->ClutPSM  = GS_PSM_CT32;
    tex->Clut     = NULL;                   // NO CPU palette upload; it's already static in VRAM!
    tex->VramClut = MASTER_CLUT_VRAM / 64;  // Point to the shared palette at 0xFFF00
    tex->Vram     = vram_base + (u32)slot * VRAM_SLOT_SIZE;
    tex->Mem      = pixels;
    tex->Filter   = GS_FILTER_NEAREST;

    // Uploads only the 8-bit texture chunk and maps it to the persistent VRAM CLUT
    gsKit_texture_upload(gsGlobal, tex);

    free(pixels);
    tex->Mem = NULL; 
}






static void load_block_into_slot(int bx, int by, int shift_x, int shift_y)
{
    int slot = slot_for(shift_x, shift_y);
    char path[224];
    void *pixels;

    build_path(path, sizeof(path), bx, by, "bgg");
    pixels = read_whole_file(path, GFX_BLOCK_W * GFX_BLOCK_H);

    if (!pixels)
    {
        screen_slot_valid[slot] = 0; return;
    }

    upload_texture(&screen_bgg_tex[slot], pixels, VRAM_BGG_BASE, slot);

    build_path(path, sizeof(path), bx, by, "lvg");
    pixels = read_whole_file(path, GFX_BLOCK_W * GFX_BLOCK_H);
    
    if (!pixels)
    {
        screen_slot_valid[slot] = 0;
        return;
    }

    upload_texture(&screen_lvg_tex[slot], pixels, VRAM_LVG_BASE, slot);

    screen_slot_valid[slot] = 1;
}

int gfx_load_level(const char *path, int startx, int starty)
{
    memset(screen_grid, 0, sizeof(screen_grid));
    memset(screen_slot_valid, 0, sizeof(screen_slot_valid));

    strncpy(screen_base_path, path, sizeof(screen_base_path) - 1);
    screen_base_path[sizeof(screen_base_path) - 1] = '\0';

    screen_shift_cx = 1;
    screen_shift_cy = 1;
    screen_scroll_x = 0;
    screen_scroll_y = 0;
    screen_pending_dx = 0;
    screen_pending_dy = 0;

    screen_grid[1][1].bx = startx;
    screen_grid[1][1].by = starty;
    screen_grid[1][1].valid = 1;

    for (int ix = 0; ix < 3; ix++)
    {
        for (int iy = 0; iy < 3; iy++)
         {
            if (ix == 1 && iy == 1) { continue; }

            int dx = ix - 1, dy = iy - 1;
            int cx = screen_grid[1][1].bx, cy = screen_grid[1][1].by;
            int nbx, nby;
            int ok = 1;

            if (dx != 0)
            {
                ok = resolve_neighbor(cx, cy, dx, 0, &nbx, &nby);
                cx = nbx; cy = nby;
            }

            if (ok && dy != 0)
            {
                ok = resolve_neighbor(cx, cy, 0, dy, &nbx, &nby);
                cx = nbx; cy = nby;
            }

            screen_grid[ix][iy].bx = cx;
            screen_grid[ix][iy].by = cy;
            screen_grid[ix][iy].valid = ok;
        }
    }

    for (int ix = 0; ix < 3; ix++)
    {
        for (int iy = 0; iy < 3; iy++)
        {
            if (screen_grid[ix][iy].valid)
            {
                load_block_into_slot(screen_grid[ix][iy].bx, screen_grid[ix][iy].by, screen_shift_cx + (ix - 1), screen_shift_cy + (iy - 1));
            }
        }
    }

    screen_active = 1;
    return 0;
}


void gfx_level_move_left(int pixels) { screen_pending_dx -= pixels; }
void gfx_level_move_right(int pixels) { screen_pending_dx += pixels; }
void gfx_level_move_up(int pixels) { screen_pending_dy -= pixels; }
void gfx_level_move_down(int pixels) { screen_pending_dy += pixels; }


static void shift_column(int dir)
{
    int new_local = (dir > 0) ? 2 : 0;
 
    for (int iy = 0; iy < 3; iy++)
    {
        BlockCoord edge = screen_grid[new_local][iy];
        int nbx, nby;
        int ok = edge.valid ? resolve_neighbor(edge.bx, edge.by, dir, 0, &nbx, &nby) : 0;
 
        if (dir > 0)
        {
            screen_grid[0][iy] = screen_grid[1][iy];
            screen_grid[1][iy] = screen_grid[2][iy];
        }
        else
        {
            screen_grid[2][iy] = screen_grid[1][iy];
            screen_grid[1][iy] = screen_grid[0][iy];
        }
 
        screen_grid[new_local][iy].bx = ok ? nbx : edge.bx;
        screen_grid[new_local][iy].by = ok ? nby : edge.by;
        screen_grid[new_local][iy].valid = ok;
    }
 
    screen_shift_cx += dir;
 
    for (int iy = 0; iy < 3; iy++)
    {
        if (screen_grid[new_local][iy].valid)
        {
            load_block_into_slot(screen_grid[new_local][iy].bx, screen_grid[new_local][iy].by, screen_shift_cx + (new_local - 1), screen_shift_cy + (iy - 1));
        }
    }
}


static void shift_row(int dir)
{
    int new_local = (dir > 0) ? 2 : 0;
 
    for (int ix = 0; ix < 3; ix++)
    {
        BlockCoord edge = screen_grid[ix][new_local];
        int nbx, nby;
        int ok = edge.valid ? resolve_neighbor(edge.bx, edge.by, 0, dir, &nbx, &nby) : 0;
 
        if (dir > 0)
        {
            screen_grid[ix][0] = screen_grid[ix][1];
            screen_grid[ix][1] = screen_grid[ix][2];
        }
        else
        {
            screen_grid[ix][2] = screen_grid[ix][1];
            screen_grid[ix][1] = screen_grid[ix][0];
        }
 
        screen_grid[ix][new_local].bx = ok ? nbx : edge.bx;
        screen_grid[ix][new_local].by = ok ? nby : edge.by;
        screen_grid[ix][new_local].valid = ok;
    }
 
    screen_shift_cy += dir;
 
    for (int ix = 0; ix < 3; ix++)
    {
        if (screen_grid[ix][new_local].valid)
        {
            load_block_into_slot(screen_grid[ix][new_local].bx, screen_grid[ix][new_local].by, screen_shift_cx + (ix - 1), screen_shift_cy + (new_local - 1));
        }
    }
}
 
void gfx_level_update(void)
{
    if (!screen_active) { return; }
 
    screen_scroll_x += screen_pending_dx; screen_pending_dx = 0;
    screen_scroll_y += screen_pending_dy; screen_pending_dy = 0;
 
    while (screen_scroll_x >= GFX_BLOCK_W)
    {
        if (!screen_grid[2][1].valid)
        {
            screen_scroll_x = GFX_BLOCK_W - 1;
            break;
        }

        screen_scroll_x -= GFX_BLOCK_W;
        shift_column(+1);
    }
    while (screen_scroll_x < 0)
    {
        if (!screen_grid[0][1].valid)
        {
            screen_scroll_x = 0;
            break;
        }
        screen_scroll_x += GFX_BLOCK_W;
        shift_column(-1);
    }
    while (screen_scroll_y >= GFX_BLOCK_H)
    {
        if (!screen_grid[1][2].valid)
        {
            screen_scroll_y = GFX_BLOCK_H - 1;
            break;
        }
        screen_scroll_y -= GFX_BLOCK_H;
        shift_row(+1);
    }
    while (screen_scroll_y < 0)
    {
        if (!screen_grid[1][0].valid)
        {
            screen_scroll_y = 0;
            break;
        }
        screen_scroll_y += GFX_BLOCK_H;
        shift_row(-1);
    }
}

void gfx_draw_level(void)
{
    for (int ix = 0; ix < 3; ix++)
    {
        for (int iy = 0; iy < 3; iy++)
        {
            if (!screen_grid[ix][iy].valid) continue;

            int slot = slot_for(screen_shift_cx + (ix - 1), screen_shift_cy + (iy - 1));
            if (!screen_slot_valid[slot]) continue;

            // Calculate screen position based on grid position and fine scroll offsets
            int draw_x = (ix - 1) * GFX_BLOCK_W - screen_scroll_x;
            int draw_y = (iy - 1) * GFX_BLOCK_H - screen_scroll_y;

            // Draw the background texture chunk
            gsKit_prim_sprite_texture(gsGlobal, &screen_bgg_tex[slot],
                draw_x, draw_y, 0, 0,
                draw_x + GFX_BLOCK_W, draw_y + GFX_BLOCK_H,
                GFX_BLOCK_W, GFX_BLOCK_H,
                1, 0x80808080);
        }
    }
}



