/*
#define VRAM_BGG_BASE   0x15000
#define VRAM_LVG_BASE   0x4C000
#define VRAM_SLOT_SIZE  0x6000
*/

GSGLOBAL *gsGlobal;
GSTEXTURE master_palette_tex;




GSTEXTURE tex;
#define TEST_VRAM_SLOT_BASE 0x15000 // Adjust to your free VRAM slot address
void load_and_test_block_0_0(void)
{
    // 1. Open the file from host/ROM/mass storage
    FILE *f = fopen("host:/screens/startup/0,0.lvl", "rb");
    if (!f) {
        // Failed to open file (check path or device initialization)
        return;
    }

    // 2. Allocate memory for 8-bit pixel indices (1 byte per pixel for T8)
    size_t data_size = 320 * 224;
    void *pixels = malloc(data_size);
    if (!pixels) {
        fclose(f);
        return;
    }

    // 3. Read raw pixel data
    fread(pixels, 1, data_size, f);
    fclose(f);

    // 4. Configure texture structure pointing to the static master palette

    tex.Width    = 320;
    tex.Height   = 224;
    tex.PSM      = GS_PSM_T8;
    tex.ClutPSM  = GS_PSM_CT32;
    tex.Clut     = NULL;                   // Skip CPU palette upload
    tex.VramClut = 0x3FC00;// / 64;  // Points to your pre-swizzled palette at 0xFFF00
    tex.Vram     = TEST_VRAM_SLOT_BASE;    // Target VRAM address for this block's pixels
    tex.Mem      = pixels;
    //tex.Filter   = GS_FILTER_NEAREST;
    tex.ClutStorageMode = GS_CLUT_STORAGE_CSM2;
    // 5. Setup texture buffer width stride
    gsKit_setup_tbw(&tex);

    gsKit_texture_send(
        (u32*)pixels, 
        tex.Width, 
        tex.Height, 
        tex.Vram, 
        tex.PSM, 
        tex.TBW, 
        GS_CLUT_TEXTURE // Skip CPU CLUT transfer flag
    );

    // 7. Cleanup CPU-side memory
    free(pixels);

/*
u32 *rgba = malloc(320 * 224 * sizeof(uint32_t));

for (int i = 0; i < 320 * 224; i++)
{
    uint8_t index = ((uint8_t *)pixels)[i];
    rgba[i] = color_palette[index];
}



    memset(&test, 0, sizeof(test));

    test.Width  = 320;
    test.Height = 224;
    test.PSM    = GS_PSM_CT32;
    test.Mem    = rgba;
    test.Vram   = TEST_VRAM_SLOT_BASE;

    gsKit_setup_tbw(&test);

