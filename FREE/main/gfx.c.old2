        rgba,
        test.Width,
        test.Height,
        test.Vram,
        test.PSM,
        test.TBW,
        0
    );
    free(pixels);
*/
}





void draw_block_0_0(void)
{
    gsKit_prim_sprite_texture(
        gsGlobal,
        &tex,
        0,                     // Screen X1 (Top-Left)
        0,                     // Screen Y1 (Top-Left)
        0,                  // Texture U1
        0,                  // Texture V1
        320, // Screen X2 (Bottom-Right)
        224,// Screen Y2 (Bottom-Right)
        320,     // Texture U2 (Width in pixels)
        224,    // Texture V2 (Height in pixels)
        0,                     // Z-depth layer
        GS_SETREG_RGBAQ(0x80, 0x80, 0x80, 0x80, 0x00) // Full brightness (unmodulated)
    );
}





void gfx_init(void)
{
    dmaKit_init(D_CTRL_RELE_OFF, D_CTRL_MFD_OFF, D_CTRL_STS_UNSPEC,
                D_CTRL_STD_OFF, D_CTRL_RCYC_8, 1 << DMA_CHANNEL_GIF);
    dmaKit_chan_init(DMA_CHANNEL_GIF);

    gsGlobal = gsKit_init_global();
    gsGlobal->ZBuffering = GS_SETTING_OFF;
    gsGlobal->Field = GS_FIELD;
    gsGlobal->DoubleBuffering = GS_SETTING_OFF;

    if (*(volatile u8 *)(PAL_NTSC))
    { gsGlobal->Mode = GS_MODE_NTSC; }else{ gsGlobal->Mode = GS_MODE_PAL; }
    if (*(volatile u8 *)(INTERLACED))
    {gsGlobal->Interlace = GS_INTERLACED; }else{ gsGlobal->Interlace = GS_NONINTERLACED; }
    gsGlobal->Width = 320;
    gsGlobal->Height = 224;
    gsGlobal->PrimAlphaEnable = GS_SETTING_ON;
    gsKit_set_test(gsGlobal, GS_ATEST_OFF);
    gsKit_init_screen(gsGlobal);
    gsKit_mode_switch(gsGlobal, GS_ONESHOT);

    master_palette_tex.Width = 16;
    master_palette_tex.Height = 16;
    master_palette_tex.PSM = GS_PSM_CT32;
    master_palette_tex.ClutPSM = 0;
    master_palette_tex.Clut = NULL;
    master_palette_tex.Mem = (void*)color_palette;
    master_palette_tex.Vram = 0x3FC00;
    master_palette_tex.VramClut = 0;
    master_palette_tex.Filter = GS_FILTER_NEAREST;

    gsKit_setup_tbw(&master_palette_tex); 

// Correct PS2 GS T8 CLUT Swizzling
for (int i = 0; i < 256; i += 32) {
    for (int j = 0; j < 8; j++) {
        uint32_t tmp = color_palette[i + j + 8];
        color_palette[i + j + 8] = color_palette[i + j + 16];
        color_palette[i + j + 16] = tmp;
    }
}



    //gsKit_texture_upload(gsGlobal, &master_palette_tex);
    gsKit_texture_send((u32*)color_palette, 16, 16, 0x3FC00, GS_PSM_CT32, master_palette_tex.TBW, GS_CLUT_PALLETE);
}
void gfx_clear(u64 color)
{
    gsKit_clear(gsGlobal, color);
}

void gfx_flip(void)
{
    gsKit_sync_flip(gsGlobal);
}
void gfx_exec(void)
{
    gsKit_queue_exec(gsGlobal);
}

void gfx_reset(void)
{
    gsKit_queue_reset(gsGlobal->Os_Queue);
}

