void gfx_init(void)
{

    dmaKit_init(D_CTRL_RELE_OFF, D_CTRL_MFD_OFF, D_CTRL_STS_UNSPEC,
                D_CTRL_STD_OFF, D_CTRL_RCYC_8, 1 << DMA_CHANNEL_GIF);
    dmaKit_chan_init(DMA_CHANNEL_GIF);

    gsGlobal = gsKit_init_global_custom(GS_RENDER_QUEUE_OS_POOLSIZE, GS_RENDER_QUEUE_PER_POOLSIZE);
    gsGlobal->ZBuffering = GS_SETTING_OFF;
    gsGlobal->Field = GS_FIELD;
    gsGlobal->DoubleBuffering = GS_SETTING_OFF;

    if (*(volatile u8 *)(PAL_NTSC))
    { gsGlobal->Mode = GS_MODE_NTSC; }else{ gsGlobal->Mode = GS_MODE_PAL; }
    gsGlobal->PSM = GS_PSM_CT16;
    gsGlobal->Interlace = GS_INTERLACED;
    gsGlobal->Width = 320;
    gsGlobal->Height = 224;
    gsGlobal->PrimAlphaEnable = GS_SETTING_ON;
    gsKit_set_test(gsGlobal, GS_ATEST_OFF);
    gsKit_init_screen(gsGlobal);
    gsKit_mode_switch(gsGlobal, GS_ONESHOT);

    //160kB VRAM usage on init raw bytes 0x27FFF gs 0x09FFF
    
    //CLUT_location = gsKit_vram_alloc(gsGlobal, gsKit_texture_size_ee(16, 16, GS_PSM_CT32), GSKIT_ALLOC_USERBUFFER);
    CLUT_location = gsKit_vram_alloc(gsGlobal, gsKit_texture_size_ee(64, 32, GS_PSM_CT32), GSKIT_ALLOC_USERBUFFER);

    master_palette.Width = 16;
    master_palette.Height = 16;
    master_palette.PSM = GS_PSM_CT32;
    master_palette.Mem = (void*)color_palette;
    master_palette.Vram = CLUT_location;
    gsKit_setup_tbw(&master_palette);

    gsKit_texture_send(
    //(u32*)color_palette, 16, 16, CLUT_location, GS_PSM_CT32, master_palette.TBW, GS_CLUT_PALLETE);
    (u32*)color_palette, 16, 16, CLUT_location, GS_PSM_CT32, master_palette.TBW, GS_CLUT_PALLETE);
    //(u32*)&master_palette, 1, 256, 0x3FFC00, GS_PSM_CT32, master_palette.TBW, GS_CLUT_PALLETE);

    for (u8 i=0; i<9; i++)
    {
        bcg_screens[i].Width = 320;
        bcg_screens[i].Height = 224;        
        bcg_screens[i].PSM=GS_PSM_T8;
        bcg_screens[i].Mem = NULL;
        bcg_screens[i].Vram = gsKit_vram_alloc(gsGlobal, gsKit_texture_size_ee(320, 224, GS_PSM_T8), GSKIT_ALLOC_USERBUFFER);
        bcg_screens[i].VramClut = CLUT_location;
        bcg_screens[i].ClutPSM = GS_PSM_CT32;
        bcg_screens[i].Clut = (u32*)color_palette;
        //gsKit_setup_tbw(&bcg_screens[i]);
        bcg_screens[i].TBW = 6;
        bcg_screens[i].ClutStorageMode = GS_CLUT_STORAGE_CSM1;
    }
    for (u8 i=0; i<9; i++)
    {
        lvl_screens[i].Width = 320;
        lvl_screens[i].Height = 224;        
        lvl_screens[i].PSM=GS_PSM_T8;
        lvl_screens[i].Mem = NULL;
        lvl_screens[i].Vram = gsKit_vram_alloc(gsGlobal, gsKit_texture_size_ee(320, 224, GS_PSM_T8), GSKIT_ALLOC_USERBUFFER);
        lvl_screens[i].VramClut = CLUT_location;
        lvl_screens[i].ClutPSM = GS_PSM_CT32;        
        lvl_screens[i].Clut = (u32*)color_palette;
        //gsKit_setup_tbw(&lvl_screens[i]);
        lvl_screens[i].TBW = 6;
        lvl_screens[i].ClutStorageMode = GS_CLUT_STORAGE_CSM1;
    }

    printf("CLUT_location: %08X\n", CLUT_location);
    for (u8 i=0; i<9; i++) printf("bcg_screens[%d].Vram: %08X\n", i, bcg_screens[i].Vram);
    for (u8 i=0; i<9; i++) printf("lvl_screens[%d].Vram: %08X\n", i, lvl_screens[i].Vram);

}

void INTERNAL_juggle_palettes(){}


void gfx_load_level(char *path)
{
    char *full_path=path_portableinator(path);
    char *screen_item_bcg[9];

    //0,0.lvg
    strcpy(screen_item_bcg[0],full_path);
    strcpy(screen_item_bcg[0],screen_x);
    strcpy(screen_item_bcg[0],",");
    strcpy(screen_item_bcg[0],screen_y);
    strcpy(screen_item_bcg[0],".lvg");

    //1,0.lvg
    strcpy(screen_item_bcg[1],full_path);
    strcpy(screen_item_bcg[1],screen_x+1);
    strcpy(screen_item_bcg[1],",");
    strcpy(screen_item_bcg[1],screen_y);
    strcpy(screen_item_bcg[1],".lvg");

    //2,0.lvg
    strcpy(screen_item_bcg[2],full_path);
    strcpy(screen_item_bcg[2],screen_x+2);
    strcpy(screen_item_bcg[2],",");
    strcpy(screen_item_bcg[2],screen_y);
    strcpy(screen_item_bcg[2],".lvg");

    //0,1.lvg
    strcpy(screen_item_bcg[0],full_path);
    strcpy(screen_item_bcg[0],screen_x);
    strcpy(screen_item_bcg[0],",");
    strcpy(screen_item_bcg[0],screen_y+1);
    strcpy(screen_item_bcg[0],".lvg");

    //1,1.lvg
    strcpy(screen_item_bcg[1],full_path);
    strcpy(screen_item_bcg[1],screen_x+1);
    strcpy(screen_item_bcg[1],",");
    strcpy(screen_item_bcg[1],screen_y+1);
    strcpy(screen_item_bcg[1],".lvg");

    //2,1.lvg
    strcpy(screen_item_bcg[2],full_path);
    strcpy(screen_item_bcg[2],screen_x+2);
    strcpy(screen_item_bcg[2],",");
    strcpy(screen_item_bcg[2],screen_y+1);
    strcpy(screen_item_bcg[2],".lvg");

    //0,2.lvg
    strcpy(screen_item_bcg[0],full_path);
    strcpy(screen_item_bcg[0],screen_x);
    strcpy(screen_item_bcg[0],",");
    strcpy(screen_item_bcg[0],screen_y+2);
    strcpy(screen_item_bcg[0],".lvg");

    //1,2.lvg
    strcpy(screen_item_bcg[1],full_path);
    strcpy(screen_item_bcg[1],screen_x+1);
    strcpy(screen_item_bcg[1],",");
    strcpy(screen_item_bcg[1],screen_y+2);
    strcpy(screen_item_bcg[1],".lvg");

    //2,2.lvg
    strcpy(screen_item_bcg[2],full_path);
    strcpy(screen_item_bcg[2],screen_x+2);
    strcpy(screen_item_bcg[2],",");
    strcpy(screen_item_bcg[2],screen_y+2);
    strcpy(screen_item_bcg[2],".lvg");


    FILE *f = fopen(full_path, "rb");
    
    size_t data_size = 320 * 224;
    void *pixels = malloc(data_size); // "IM A GLUTTON FOR YOUR PIXELS, THAT'S HOW I FEED..." -Gumi

    fread(pixels, 1, data_size, f);
    fclose(f);

    GSTEXTURE *tex = &bcg_screens[8];
    tex->Mem = pixels;

    // Send data to its pre-calculated address segment
    gsKit_texture_send(
        (u32*)pixels, 
        tex->Width, 
        tex->Height, 
        tex->Vram, 
        GS_PSM_T8, //tex->PSM, 
        tex->TBW, 
        GS_CLUT_TEXTURE
    );    

    free(pixels);

}

void gfx_update(void)
{

    //if ()


    gsKit_prim_sprite_texture(
        gsGlobal,
        &bcg_screens[8],
        0,                  // Screen X1 (Top-Left)
        0,                  // Screen Y1 (Top-Left)
        0,                         // Texture U1 (Read from pixel 0)
        0,                         // Texture V1 (Read from pixel 0)
        320,            // Screen X2 (Bottom-Right Screen Boundary)
        224,            // Screen Y2 (Bottom-Right Screen Boundary)
        320,                       // Texture U2 (Full image width crop)
        224,                       // Texture V2 (Full image height crop)
        1,                         // Z-depth prioritization layer 
        GS_SETREG_RGBAQ(0x80, 0x80, 0x80, 0x80, 0x00) // Full unmodulated brightness tint
    );






    gsKit_lock_buffer(gsGlobal);

    gsKit_queue_exec(gsGlobal);  

    gsKit_unlock_buffer(gsGlobal);

    gsKit_sync_flip(gsGlobal);
    gsKit_queue_reset(gsGlobal->Os_Queue);

}

