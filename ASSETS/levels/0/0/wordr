# ------------------------------------------------------------------ config
TILE_W, TILE_H = 320, 224
TILE_BYTES = TILE_W * TILE_H
MAX_CELL = 999                        # X and Y in a file name can't go above this
LAYER_ORDER = ["bcg", "lvg"]          # bottom -> top. Any other *g extension is stacked on top, A-Z
EXCLUDE_EXT = {"png", "jpg", "jpeg", "svg", "ogg"}   # end in g but are not tiles
SKIP_DIRS = {"__pycache__", "node_modules"}
SCAN_DEPTH = 6
UI_WIDTH = 340
SB = 14                               # scrollbar thickness
ZOOMS = [0.125, 0.25, 0.5, 1, 2, 3, 4, 6, 8, 12, 16, 24, 32, 48, 64]   # tile size stays a whole number of pixels
MAX_UNDO = 200
ALPHA_CUTOFF = 128                    # import: alpha below this -> index 0 (transparent)
BLACK_REPLACEMENT = 8                 # import: an opaque pixel that would be 000 becomes 002 (000 = transparent)
MAX_IMPORT_PIXELS = 40_000_000
TOOLS = ["draw", "select", "eraser", "bucket", "picker"]

