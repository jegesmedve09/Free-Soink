# ------------------------------------------------------------------ colour quantiser (from cutr, used by image import)
R_LEVELS = [0, 64, 128, 192]
G_LEVELS = B_LEVELS = [0, 32, 64, 96, 128, 160, 192, 224]


def _palette_is_grid():
    return all(palette_rgb[i] == (R_LEVELS[i >> 6], G_LEVELS[i & 7], B_LEVELS[(i >> 3) & 7]) for i in range(256))


def _nearest_level(levels, v):
    return min(range(len(levels)), key=lambda i: abs(levels[i] - v))


FAST_QUANT = _palette_is_grid()
if FAST_QUANT:
    _RT = bytes(_nearest_level(R_LEVELS, v) * 64 for v in range(256))
    _GT = bytes(_nearest_level(G_LEVELS, v) for v in range(256))
    _BT = bytes(_nearest_level(B_LEVELS, v) * 8 for v in range(256))
_slow_cache = {}


def quantize_rgba(raw):
    """RGBA bytes -> bytes of palette indices (alpha < cutoff -> 0, opaque black -> 002)."""
    if FAST_QUANT:
        rs = raw[0::4].translate(_RT)
        gs = raw[1::4].translate(_GT)
        bs = raw[2::4].translate(_BT)
        al = raw[3::4]
        return bytes(0 if a < ALPHA_CUTOFF else ((r + g + b) or BLACK_REPLACEMENT)
                     for r, g, b, a in zip(rs, gs, bs, al))
    out = bytearray(len(raw) // 4)
    for i in range(len(out)):
        r, g, b, a = raw[4 * i:4 * i + 4]
        if a < ALPHA_CUTOFF:
            continue
        idx = _slow_cache.get((r, g, b))
        if idx is None:
            idx = min(range(256), key=lambda k: (r - palette_rgb[k][0]) ** 2 +
                      (g - palette_rgb[k][1]) ** 2 + (b - palette_rgb[k][2]) ** 2)
            idx = idx or BLACK_REPLACEMENT
            _slow_cache[(r, g, b)] = idx
        out[i] = idx
    return bytes(out)


_tobytes = getattr(pygame.image, "tobytes", None) or pygame.image.tostring


# ------------------------------------------------------------------ project scan
TILE_RE = re.compile(r"(\d+),(\d+)")


def natural_key(s):
    return [int(t) if t.isdigit() else t.lower() for t in re.split(r"(\d+)", s)]


def layer_sort_key(ext):
    if ext in LAYER_ORDER:
        return (0, LAYER_ORDER.index(ext), ext)
    return (1, 0, ext)


def scan_project(root):
    """Walk `root`. Returns (maps, notes).

    maps  = {folder: {ext_lowercase: {"disp": ext as written, "files": {(x, y): path}}}}
    notes = list of human readable warnings (wrong size, duplicates)
    """
    maps, wrong_size, dups = {}, [], 0
    root = os.path.abspath(root)
    base = root.rstrip(os.sep).count(os.sep)
    for dirpath, dirnames, filenames in os.walk(root):
        if dirpath.count(os.sep) - base >= SCAN_DEPTH:
            dirnames[:] = []
        else:
            dirnames[:] = sorted((d for d in dirnames if not d.startswith(".") and d not in SKIP_DIRS),
                                 key=natural_key)
        for fn in filenames:
            stem, ext = os.path.splitext(fn)
            e = ext[1:]
            if not e or not e.lower().endswith("g") or e.lower() in EXCLUDE_EXT:
                continue
            m = TILE_RE.fullmatch(stem)
            if not m:
                continue
            x, y = int(m.group(1)), int(m.group(2))
            if x > MAX_CELL or y > MAX_CELL:
                continue
            path = os.path.join(dirpath, fn)
            try:
                if os.path.getsize(path) != TILE_BYTES:
                    wrong_size.append(path)
                    continue
            except OSError:
                continue
            layer = maps.setdefault(dirpath, {}).setdefault(e.lower(), {"disp": e, "files": {}})
            if (x, y) in layer["files"]:
                dups += 1
                continue
            layer["files"][(x, y)] = path
    notes = []
    if wrong_size:
        notes.append(f"{len(wrong_size)} file(s) skipped: not {TILE_BYTES} bytes (e.g. {os.path.basename(wrong_size[0])})")
    if dups:
        notes.append(f"{dups} duplicate file(s) ignored (same X,Y and extension, different letter case)")
    return maps, notes


# ------------------------------------------------------------------ data model
class Tile:
    """One 320x224 screen of one layer."""
    __slots__ = ("data", "path", "dirty", "version", "_surf", "_surf_ver", "_buf", "_scaled")

    def __init__(self, data=None, path=None):
        self.data = data if data is not None else bytearray(TILE_BYTES)
        self.path = path
        self.dirty = False
        self.version = 0          # bumped on every change; surfaces are rebuilt when it moves
        self._surf = None
        self._surf_ver = -1
        self._buf = None
        self._scaled = None

    def surface(self):
        """8-bit palettised surface of the tile, index 0 = colour key (transparent)."""
        if self._surf_ver != self.version:
            self._buf = bytes(self.data)
            s = pygame.image.frombuffer(self._buf, (TILE_W, TILE_H), "P")
            s.set_palette(palette_rgb)
            s.set_colorkey(0)
            self._surf, self._surf_ver = s, self.version
        return self._surf

    def scaled(self, zoom):
        """Cached down-scaled surface for zoom < 1."""
        c = self._scaled
        if c and c[0] == zoom and c[1] == self.version:
            return c[2]
        sc = pygame.transform.scale(self.surface(), (int(TILE_W * zoom), int(TILE_H * zoom)))
        sc.set_colorkey(0)
        self._scaled = (zoom, self.version, sc)
        return sc


class Layer:
    def __init__(self, ext, disp):
        self.ext = ext            # lowercase key
        self.disp = disp          # extension as it is written on disk (used for new files)
        self.tiles = {}           # (cx, cy) -> Tile
        self.visible = True


def line_points(x0, y0, x1, y1):
    """Bresenham, both ends included."""
    dx, dy = abs(x1 - x0), -abs(y1 - y0)
    sx = 1 if x0 < x1 else -1
    sy = 1 if y0 < y1 else -1
    err = dx + dy
    while True:
        yield x0, y0
        if x0 == x1 and y0 == y1:
            return
        e2 = 2 * err
        if e2 >= dy:
            err += dy
            x0 += sx
        if e2 <= dx:
            err += dx
            y0 += sy


def pieces(x, y, w, h):
    """Split the world rectangle (x, y, w, h) into per-screen pieces.

    yields (cx, cy, tx, ty, pw, ph, dx, dy): screen cell, position inside that screen, size of the
    piece, and its offset inside the rectangle. Anything left of / above 0 or beyond MAX_CELL is dropped.
    """
    x0, y0 = max(x, 0), max(y, 0)
    x1, y1 = min(x + w, (MAX_CELL + 1) * TILE_W), min(y + h, (MAX_CELL + 1) * TILE_H)
    if x1 <= x0 or y1 <= y0:
        return
    cy = y0 // TILE_H
    while cy * TILE_H < y1:
        cx = x0 // TILE_W
        while cx * TILE_W < x1:
            ax0, ax1 = max(x0, cx * TILE_W), min(x1, (cx + 1) * TILE_W)
            ay0, ay1 = max(y0, cy * TILE_H), min(y1, (cy + 1) * TILE_H)
            yield cx, cy, ax0 - cx * TILE_W, ay0 - cy * TILE_H, ax1 - ax0, ay1 - ay0, ax0 - x, ay0 - y
            cx += 1
        cy += 1


class GameMap:
    """All the layers of one folder, editable as one big canvas, with its own undo history."""

    def __init__(self, name, folder, spec):
        self.name, self.folder, self.spec = name, folder, spec
        self.layers = []
        self.loaded = False
        self.undo, self.redo, self.cur = [], [], None
        self._bbox = None         # None = stale, False = no tiles at all
        self.view = None          # (zoom, ox, oy) remembered while another map is shown
        self.active = None        # index of the layer being edited

    # ---------------------------------------------------------- loading / saving
    def load(self):
        errors = []
        for ext in sorted(self.spec, key=layer_sort_key):
            info = self.spec[ext]
            layer = Layer(ext, info["disp"])
            for cell, path in info["files"].items():
                try:
                    with open(path, "rb") as f:
                        data = f.read()
                    if len(data) != TILE_BYTES:
                        raise ValueError(f"{len(data)} bytes")
                    layer.tiles[cell] = Tile(bytearray(data), path)
                except (OSError, ValueError) as e:
                    errors.append(f"{os.path.basename(path)}: {e}")
            self.layers.append(layer)
        self.loaded = True
        self._bbox = None
        return errors

    def dirty_count(self):
        return sum(1 for l in self.layers for t in l.tiles.values() if t.dirty)

    def save(self):
        """Write every changed screen. Returns (files_written, error_strings)."""
        written, errors = 0, []
        for layer in self.layers:
            for (cx, cy), t in layer.tiles.items():
                if not t.dirty:
                    continue
                path = t.path
                if path is None:
                    if t.data.count(0) == TILE_BYTES:      # brand new and still blank: no file
                        t.dirty = False
                        continue
                    path = os.path.join(self.folder, f"{cx},{cy}.{layer.disp}")
                    if os.path.exists(path):
                        errors.append(f"{cx},{cy}.{layer.disp}: a file with that name exists but couldn't be loaded - not overwritten")
                        continue
                try:
                    tmp = path + ".tmp"
                    with open(tmp, "wb") as f:
                        f.write(t.data)
                    os.replace(tmp, path)
                except OSError as e:
                    errors.append(f"{os.path.basename(path)}: {e}")
                    continue
                t.path, t.dirty = path, False
                written += 1
            blank = [c for c, t in layer.tiles.items() if t.path is None and not t.dirty]
            for c in blank:                       # blank screens that never got a file: forget them
                del layer.tiles[c]
            if blank:
                self._bbox = None
        return written, errors

    # ---------------------------------------------------------- geometry
    def cells_bbox(self):
        """(cx0, cy0, cx1, cy1) over the screens of ALL layers, or None."""
        if self._bbox is None:
            xs = [c[0] for l in self.layers for c in l.tiles]
            ys = [c[1] for l in self.layers for c in l.tiles]
            self._bbox = (min(xs), min(ys), max(xs), max(ys)) if xs else False
        return self._bbox or None

    # ---------------------------------------------------------- undo machinery
    def begin(self):
        if self.cur is None:
            self.cur = {}

    def end(self):
        if self.cur:
            self.undo.append(self.cur)
            del self.undo[:-MAX_UNDO]
            self.redo.clear()
        self.cur = None

    def _touch(self, layer, cell):
        """Remember what this screen looked like before the first change of the current step."""
        if self.cur is None:
            self.cur = {}
        key = (layer.ext, cell[0], cell[1])
        if key not in self.cur:
            t = layer.tiles.get(cell)
            self.cur[key] = None if t is None else zlib.compress(bytes(t.data), 1)

    def _writable(self, layer, cell):
        self._touch(layer, cell)
        t = layer.tiles.get(cell)
        if t is None:
            t = layer.tiles[cell] = Tile()
            self._bbox = None
        return t

    def _swap(self, change):
        """Restore the snapshots in `change`; returns the snapshots of what was there before."""
        inv = {}
        for (ext, cx, cy), snap in change.items():
            layer = next(l for l in self.layers if l.ext == ext)
            t = layer.tiles.get((cx, cy))
            inv[(ext, cx, cy)] = None if t is None else zlib.compress(bytes(t.data), 1)
            if snap is None:
                if t is None:
                    continue
                if t.path is None:               # never reached the disk: really remove it again
                    del layer.tiles[(cx, cy)]
                    self._bbox = None
                    continue
                t.data[:] = bytes(TILE_BYTES)    # it has a file: keep it, blank
            else:
                if t is None:
                    t = layer.tiles[(cx, cy)] = Tile()
                    self._bbox = None
                t.data[:] = zlib.decompress(snap)
            t.dirty = True
            t.version += 1
        return inv

    def do_undo(self):
        self.end()
        if not self.undo:
            return 0
        change = self.undo.pop()
        self.redo.append(self._swap(change))
        return len(change)

    def do_redo(self):
        self.end()
        if not self.redo:
            return 0
        change = self.redo.pop()
        self.undo.append(self._swap(change))
        return len(change)

    # ---------------------------------------------------------- pixel access (world coordinates)
    def get_px(self, layer, wx, wy):
        if wx < 0 or wy < 0:
            return 0
        t = layer.tiles.get((wx // TILE_W, wy // TILE_H))
        return 0 if t is None else t.data[(wy % TILE_H) * TILE_W + wx % TILE_W]

    def set_px(self, layer, wx, wy, v):
        if wx < 0 or wy < 0:
            return False
        cx, tx = divmod(wx, TILE_W)
        cy, ty = divmod(wy, TILE_H)
        if cx > MAX_CELL or cy > MAX_CELL:
            return False
        i = ty * TILE_W + tx
        t = layer.tiles.get((cx, cy))
        if t is None:
            if v == 0:                       # transparent on a screen that doesn't exist: nothing to do
                return False
        elif t.data[i] == v:
            return False
        t = self._writable(layer, (cx, cy))
        t.data[i] = v
        t.dirty = True
        t.version += 1
        return True

    def read_region(self, layer, x, y, w, h):
        out = bytearray(w * h)
        for cx, cy, tx, ty, pw, ph, dx, dy in pieces(x, y, w, h):
            t = layer.tiles.get((cx, cy))
            if t is None:
                continue
            for r in range(ph):
                s = (ty + r) * TILE_W + tx
                d = (dy + r) * w + dx
                out[d:d + pw] = t.data[s:s + pw]
        return out

    def write_region(self, layer, x, y, w, h, data):
        """Overwrite the rectangle with `data` (w*h bytes, index 0 included, like drawr's paste)."""
        for cx, cy, tx, ty, pw, ph, dx, dy in pieces(x, y, w, h):
            t = layer.tiles.get((cx, cy))
            touched = False
            for r in range(ph):
                s = (ty + r) * TILE_W + tx
                d = (dy + r) * w + dx
                new = data[d:d + pw]
                if t is None:
                    if new.count(0) == pw:
                        continue
                elif t.data[s:s + pw] == new:
                    continue
                t = self._writable(layer, (cx, cy))
                t.data[s:s + pw] = new
                touched = True
            if touched:
                t.dirty = True
                t.version += 1

    def flood_fill(self, layer, wx, wy, new):
        """Scanline fill on one layer, limited to the level's extent. Returns 'ok', 'same' or 'outside'."""
        bb = self.cells_bbox()
        cx, cy = wx // TILE_W, wy // TILE_H
        if wx < 0 or wy < 0 or bb is None or not (bb[0] <= cx <= bb[2] and bb[1] <= cy <= bb[3]):
            return "outside"
        ncols, nrows = bb[2] - bb[0] + 1, bb[3] - bb[1] + 1
        W, H = ncols * TILE_W, nrows * TILE_H
        lx, ly = wx - bb[0] * TILE_W, wy - bb[1] * TILE_H
        rows = {}                                    # local y -> [original bytes, working bytearray]

        def row(y):
            r = rows.get(y)
            if r is None:
                buf = bytearray(W)
                cell_y, ty = bb[1] + y // TILE_H, y % TILE_H
                for c in range(ncols):
                    t = layer.tiles.get((bb[0] + c, cell_y))
                    if t is not None:
                        buf[c * TILE_W:(c + 1) * TILE_W] = t.data[ty * TILE_W:(ty + 1) * TILE_W]
                r = rows[y] = [bytes(buf), buf]
            return r[1]

        target = row(ly)[lx]
        if target == new:
            return "same"
        tb, nb = bytes([target]), bytes([new])
        run = re.compile(re.escape(tb) + b"+")
        stack = [(lx, ly)]
        while stack:
            x, y = stack.pop()
            w = row(y)
            if w[x] != target:
                continue
            left = len(w[:x + 1].rstrip(tb))
            seg = w[x:]
            right = x + len(seg) - len(seg.lstrip(tb))
            w[left:right] = nb * (right - left)
            for ny in (y - 1, y + 1):
                if 0 <= ny < H:
                    for m in run.finditer(row(ny), left, right):
                        stack.append((m.start(), ny))
        touched = set()
        for y, (orig, work) in rows.items():
            if work == orig:
                continue
            cell_y, ty = bb[1] + y // TILE_H, y % TILE_H
            for c in range(ncols):
                a, b = c * TILE_W, (c + 1) * TILE_W
                if work[a:b] != orig[a:b]:
                    t = self._writable(layer, (bb[0] + c, cell_y))
                    t.data[ty * TILE_W:(ty + 1) * TILE_W] = work[a:b]
                    touched.add(t)
        for t in touched:
            t.dirty = True
            t.version += 1
        return "ok"


