#!/usr/bin/env python3
"""
worldr - drawr for a whole level.

Point it at a project folder. It scans it for every "X,Y.<ext>" file whose extension ends
with g (lvg, bcg, xpg, ...), each one a raw 320x224 8bpp screen, and lays them out on ONE big
canvas at their X,Y positions. You paint on the level, not on a screen: a stroke that crosses
from screen 2,1 into screen 3,1 just works, and every touched file is saved back on its own.

  * every folder that directly holds X,Y.*g files is one "map" (levels/0/1, levels/0/2, ...)
  * every extension inside a map is one "layer" (bcg under lvg, ...); you edit ONE layer at
    a time, the others are shown underneath / above it and can be hidden
  * index 0 (000) is transparent, so lower layers show through it (B = checker backdrop)
  * painting on a screen that has no file yet creates it; it is written when you save
    (a new screen that is still all 0x00 is never written)
  * files that aren't exactly 320*224 = 71680 bytes are left alone and reported

Controls
  Mouse       LMB use tool | MMB or RMB drag = pan | Wheel scroll | Shift+Wheel sideways | Ctrl+Wheel zoom
  T           cycle tool: draw > select > eraser > bucket > picker
  E / Q       colour +1 / -1                 (click a swatch to pick one)
  [ ]  1-9    choose the layer you edit      V  show / hide that layer
  G           grid + X,Y labels              B  checker / black backdrop for transparent
  F           fit the level in the window    + / -  zoom      arrows  pan
  Ctrl+C/X/V  copy / cut / paste (active layer, works across screens)   Enter or click = stamp
  Ctrl+Alt + drag inside a selection = move it      Del = clear selection     Esc = cancel/clear
  Ctrl+Z / Ctrl+Y   undo / redo (per map, works across all the files a stroke touched)
  I           import an image and stamp it (native size, quantised like cutr)
  O           open project folder            S or Ctrl+S   save every changed file
  F5          reload the folder from disk
  PgUp/PgDn   previous / next map            F1  help

Usage:  python3 worldr.py [project_folder]
"""
import math
import os
import re
import sys
import zlib

import pygame

