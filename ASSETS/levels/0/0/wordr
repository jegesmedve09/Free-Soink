class App:
    def __init__(self):
        pygame.init()
        self.tkroot = None
        if tk:
            try:
                self.tkroot = tk.Tk()
                self.tkroot.withdraw()
                self.tkroot.update()
            except tk.TclError:
                self.tkroot = None
        info = pygame.display.Info()
        size = (max(UI_WIDTH + 400, min(1300, info.current_w - 60)), max(700, min(860, info.current_h - 100)))
        self.screen = pygame.display.set_mode(size, pygame.RESIZABLE)
        self.clock = pygame.time.Clock()
        self.font = pygame.font.SysFont(None, 20)
        self.font_small = pygame.font.SysFont(None, 18)
        self.font_bold = pygame.font.SysFont(None, 22, bold=True)

        self.root = None
        self.maps = []
        self.mi = 0
        self.zoom, self.ox, self.oy = 1, 20, 20

        self.tool = "draw"
        self.color = 0
        self.show_grid = True
        self.checker_bg = False
        self.show_help = False
        self.mouse = pygame.mouse.get_pos()

        self.stroking = False
        self.last = None
        self.panning = False
        self.drag_bar = None
        self.selection_start = None
        self.selection_box = None            # [x, y, w, h] in world pixels
        self.clipboard = None                # {'w', 'h', 'data'}
        self.is_pasting = False
        self.paste_x = self.paste_y = 0
        self.is_moving = False
        self.move_buffer = None
        self.move_x = self.move_y = 0
        self.grab_ox = self.grab_oy = 0

        self.status, self.status_until = "", 0
        self.quit_armed = 0                  # ticks until which a second 'discard' request is accepted
        self.running = True
        self._ghost = None
        self._checker = None
        self._caption = None

    # ---------------------------------------------------------- small helpers
    @property
    def map(self):
        return self.maps[self.mi] if self.maps else None

    @property
    def layer(self):
        m = self.map
        if m and m.active is not None and 0 <= m.active < len(m.layers):
            return m.layers[m.active]
        return None

    def say(self, msg, ms=6000):
        self.status = msg
        self.status_until = pygame.time.get_ticks() + ms
        print(msg)

    def mods(self):
        return pygame.key.get_mods()

    def dirty_count(self):
        return sum(m.dirty_count() for m in self.maps)

    def editable(self):
        l = self.layer
        if l is None:
            self.say("Nothing to edit - press O to open a project folder")
            return False
        if not l.visible:
            self.say(f"Layer .{l.disp} is hidden - press V to show it")
            return False
        return True

    def to_world(self, pos):
        return int((pos[0] - self.ox) // self.zoom), int((pos[1] - self.oy) // self.zoom)

    def to_screen(self, wx, wy):
        return int(round(self.ox + wx * self.zoom)), int(round(self.oy + wy * self.zoom))

    # ---------------------------------------------------------- layout (shared by drawing and clicking)
    def layout(self):
        w, h = self.screen.get_size()
        ux = w - UI_WIDTH
        L = {"ux": ux, "w": w, "h": h}
        L["view"] = pygame.Rect(0, 0, ux - SB, h - SB)
        L["vbar"] = pygame.Rect(ux - SB, 0, SB, h - SB)
        L["hbar"] = pygame.Rect(0, h - SB, ux - SB, SB)
        bx, bw = ux + 15, UI_WIDTH - 30
        btn_y = h - 10 - 3 * 35
        L["buttons"] = [pygame.Rect(bx, btn_y + i * 35, bw, 30) for i in range(3)]
        cell = 16 if h >= 780 else 12                 # smaller swatches on short windows so the lists still fit
        L["cell"] = cell
        L["pal"] = pygame.Rect(bx, btn_y - 10 - 16 * cell, 16 * cell, 16 * cell)
        y = 12 + 12 * 17 + 4
        avail = L["pal"].top - y - 6
        n_l = len(self.map.layers) if self.map else 0
        n_m = len(self.maps) if len(self.maps) > 1 else 0
        rl, rm = min(n_l, 6), min(n_m, 5)

        def need(r_l, r_m):
            return (18 + r_l * 18 if r_l else 0) + (24 + r_m * 18 if r_m else 0)
        while need(rl, rm) > avail and (rl > 1 or rm > 1):
            if rm >= rl and rm > 1:
                rm -= 1
            else:
                rl -= 1
        L["layers_hdr"] = y
        y += 18
        L["layer_rows"] = []
        for i in range(rl):
            r = pygame.Rect(bx, y + i * 18, bw, 17)
            L["layer_rows"].append((i, r, pygame.Rect(r.x, r.y, 22, r.h)))
        y += rl * 18
        L["maps_hdr"] = y + 6
        y += 24 if rm else 0
        L["map_rows"] = []
        first = 0
        if rm and self.mi >= rm:
            first = min(self.mi - rm // 2, n_m - rm)
            first = max(0, first)
        L["map_first"], L["map_n"] = first, n_m
        for i in range(rm):
            L["map_rows"].append((first + i, pygame.Rect(bx, y + i * 18, bw, 17)))
        return L

    # ---------------------------------------------------------- project / maps
    def open_project(self, path):
        path = os.path.abspath(path)
        if not os.path.isdir(path):
            self.say(f"Not a folder: {path}")
            return False
        found, notes = scan_project(path)
        if not found:
            self.say("No X,Y.*g tile files found in " + path + (" (" + "; ".join(notes) + ")" if notes else ""))
            return False
        maps = []
        for folder in sorted(found, key=lambda f: natural_key(os.path.relpath(f, path))):
            name = os.path.relpath(folder, path)
            maps.append(GameMap("(project root)" if name == "." else name.replace(os.sep, "/"), folder, found[folder]))
        self.cancel_transient()
        self.root, self.maps, self.mi = path, maps, 0
        self._enter_map()
        msg = f"Opened {os.path.basename(path) or path}: {len(maps)} map(s)"
        if notes:
            msg += " | " + "; ".join(notes)
        self.say(msg)
        return True

    def _enter_map(self):
        m = self.map
        if not m.loaded:
            errs = m.load()
            if errs:
                self.say(f"{len(errs)} file(s) failed to load: " + "; ".join(errs[:3]))
            m.active = next((k for k, l in enumerate(m.layers) if l.ext == "lvg"), len(m.layers) - 1) if m.layers else None
        if m.view:
            self.zoom, self.ox, self.oy = m.view
            self.clamp_camera()
        else:
            self.fit_view()

    def switch_map(self, i):
        if not self.maps or i == self.mi or not (0 <= i < len(self.maps)):
            return
        self.cancel_transient()
        self.map.view = (self.zoom, self.ox, self.oy)
        self.mi = i
        self._enter_map()

    def set_layer(self, i):
        m = self.map
        if m and 0 <= i < len(m.layers):
            self.cancel_transient(keep_selection=True)
            m.active = i
            m.layers[i].visible = True

    def cancel_transient(self, keep_selection=False):
        if self.is_moving:
            self.commit_move()
        self.is_pasting = False
        if not keep_selection:
            self.selection_start = self.selection_box = None
        self.stroking = False
        self.last = None
        if self.map:
            self.map.end()

    # ---------------------------------------------------------- camera
    def scroll_bounds(self):
        bb = self.map.cells_bbox() if self.map else None
        bb = bb or (0, 0, 0, 0)
        return (max(-TILE_W, (bb[0] - 2) * TILE_W), (bb[2] + 3) * TILE_W,
                max(-TILE_H, (bb[1] - 2) * TILE_H), (bb[3] + 3) * TILE_H)

    def clamp_camera(self):
        view = self.layout()["view"]
        x_lo, x_hi, y_lo, y_hi = self.scroll_bounds()
        z = self.zoom
        self.ox = int(max(50 - x_hi * z, min(view.w - 50 - x_lo * z, self.ox)))
        self.oy = int(max(50 - y_hi * z, min(view.h - 50 - y_lo * z, self.oy)))

    def fit_view(self):
        view = self.layout()["view"]
        bb = (self.map.cells_bbox() if self.map else None) or (0, 0, 0, 0)
        w, h = (bb[2] - bb[0] + 1) * TILE_W, (bb[3] - bb[1] + 1) * TILE_H
        z = ZOOMS[0]
        for cand in ZOOMS:
            if w * cand <= view.w - 30 and h * cand <= view.h - 30:
                z = cand
        self.zoom = z
        self.ox = int((view.w - w * z) // 2 - bb[0] * TILE_W * z)
        self.oy = int((view.h - h * z) // 2 - bb[1] * TILE_H * z)
        self.clamp_camera()

    def set_zoom(self, new_z, anchor=None):
        if new_z == self.zoom:
            return
        view = self.layout()["view"]
        ax, ay = anchor if anchor else view.center
        wx, wy = (ax - self.ox) / self.zoom, (ay - self.oy) / self.zoom
        self.zoom = new_z
        self.ox, self.oy = int(round(ax - wx * new_z)), int(round(ay - wy * new_z))
        self.clamp_camera()

    def step_zoom(self, step, anchor=None):
        i = ZOOMS.index(self.zoom) if self.zoom in ZOOMS else ZOOMS.index(1)
        self.set_zoom(ZOOMS[max(0, min(len(ZOOMS) - 1, i + step))], anchor)

    def bar_geom(self, axis):
        L = self.layout()
        x_lo, x_hi, y_lo, y_hi = self.scroll_bounds()
        if axis == "h":
            lo, hi, vis, pos, track = x_lo, x_hi, L["view"].w / self.zoom, -self.ox / self.zoom, L["hbar"].w
        else:
            lo, hi, vis, pos, track = y_lo, y_hi, L["view"].h / self.zoom, -self.oy / self.zoom, L["vbar"].h
        total = hi - lo
        if vis >= total:
            return None
        thumb = max(20, int(track * vis / total))
        frac = max(0.0, min(1.0, (pos - lo) / (total - vis)))
        return track, thumb, frac, lo, total, vis

    def drag_scroll(self, axis, m):
        g = self.bar_geom(axis)
        if not g:
            return
        track, thumb, _, lo, total, vis = g
        f = max(0.0, min(1.0, (m - thumb / 2) / max(1, track - thumb)))
        pos = lo + f * (total - vis)
        if axis == "h":
            self.ox = int(round(-pos * self.zoom))
        else:
            self.oy = int(round(-pos * self.zoom))
        self.clamp_camera()

    # ---------------------------------------------------------- editing actions
    def stroke_to(self, wx, wy):
        layer = self.layer
        v = self.color if self.tool == "draw" else 0
        x0, y0 = self.last if self.last else (wx, wy)
        for x, y in line_points(x0, y0, wx, wy):
            self.map.set_px(layer, x, y, v)
        self.last = (wx, wy)

    def pick_color(self, wx, wy):
        for layer in reversed(self.map.layers):
            if layer.visible:
                v = self.map.get_px(layer, wx, wy)
                if v:
                    self.color = v
                    return
        self.color = 0

    def do_fill(self, wx, wy):
        m = self.map
        m.begin()
        res = m.flood_fill(self.layer, wx, wy, self.color)
        m.end()
        if res == "outside":
            self.say("Bucket only works inside the level's extent (paint a first pixel to add a screen there)")

    def update_selection(self, pos):
        wx, wy = self.to_world(pos)
        sx0, sy0 = self.selection_start
        x, y = max(0, min(sx0, wx)), max(0, min(sy0, wy))
        self.selection_box = [x, y, max(sx0, wx) - x + 1, max(sy0, wy) - y + 1]

    def copy_selection(self, quiet=False):
        if not self.selection_box or not self.layer:
            self.say("No selection to copy!")
            return False
        x, y, w, h = self.selection_box
        self.clipboard = {"w": w, "h": h, "data": bytes(self.map.read_region(self.layer, x, y, w, h))}
        if not quiet:
            self.say(f"Copied {w}x{h}")
        return True

    def clear_selection_pixels(self):
        x, y, w, h = self.selection_box
        m = self.map
        m.begin()
        m.write_region(self.layer, x, y, w, h, bytes(w * h))
        m.end()

    def cut_selection(self):
        if self.editable() and self.copy_selection(quiet=True):
            self.clear_selection_pixels()
            self.say("Cut selection")

    def start_paste(self):
        if not self.clipboard:
            self.say("Clipboard is empty!")
            return
        if not self.editable():
            return
        view = self.layout()["view"]
        pos = self.mouse if view.collidepoint(self.mouse) else view.center
        self.paste_x, self.paste_y = self.to_world(pos)
        self.is_pasting = True
        self.say("Paste mode: click or Enter to stamp, Esc to cancel")

    def commit_paste(self):
        if self.is_pasting and self.clipboard and self.editable():
            c = self.clipboard
            m = self.map
            m.begin()
            m.write_region(self.layer, self.paste_x, self.paste_y, c["w"], c["h"], c["data"])
            m.end()
            self.is_pasting = False
            self.say("Stamped")

    def start_move(self, wx, wy):
        if not self.selection_box or not self.editable():
            return
        sx, sy, sw, sh = self.selection_box
        if not (sx <= wx < sx + sw and sy <= wy < sy + sh):
            return
        m = self.map
        m.begin()
        self.move_buffer = {"w": sw, "h": sh, "data": bytes(m.read_region(self.layer, sx, sy, sw, sh))}
        m.write_region(self.layer, sx, sy, sw, sh, bytes(sw * sh))
        self.is_moving = True
        self.move_x, self.move_y = sx, sy
        self.grab_ox, self.grab_oy = wx - sx, wy - sy
        self.selection_box = None

    def commit_move(self):
        if not self.is_moving or not self.move_buffer:
            self.is_moving = False
            return
        b = self.move_buffer
        m = self.map
        m.write_region(self.layer, self.move_x, self.move_y, b["w"], b["h"], b["data"])
        m.end()
        self.selection_box = [self.move_x, self.move_y, b["w"], b["h"]]
        self.is_moving = False
        self.move_buffer = None

    def do_undo(self, redo=False):
        if not self.map or self.stroking or self.is_moving:
            return
        self.is_pasting = False
        n = self.map.do_redo() if redo else self.map.do_undo()
        self.say(("Redid" if redo else "Undid") + f" a change to {n} screen file(s)" if n
                 else ("Nothing to redo" if redo else "Nothing to undo"))

    def save_all(self):
        if not self.maps:
            return
        self.cancel_transient(keep_selection=True)
        written, errors = 0, []
        for m in self.maps:
            if m.loaded:
                w, e = m.save()
                written += w
                errors += e
        self.quit_armed = 0
        msg = f"Saved {written} file(s)"
        if errors:
            msg += f" - {len(errors)} problem(s): " + "; ".join(errors[:2])
        self.say(msg, 9000 if errors else 5000)

    def ask_folder(self):
        if not self.tkroot:
            self.say("No tkinter here - start worldr with the project folder as an argument")
            return None
        return filedialog.askdirectory(master=self.tkroot, title="Open project folder") or None

    def ask_image(self):
        if not self.tkroot:
            self.say("No tkinter here - can't show a file dialog")
            return None
        return filedialog.askopenfilename(
            master=self.tkroot, title="Import image",
            filetypes=[("Image Files", "*.png *.jpg *.jpeg *.bmp *.gif *.tga *.webp"), ("All Files", "*.*")]) or None

    def maybe_save_first(self):
        """True if it's fine to throw the current project away."""
        n = self.dirty_count()
        if n == 0:
            return True
        if self.tkroot:
            ans = messagebox.askyesnocancel("worldr", f"{n} screen file(s) have unsaved changes.\n\nSave them first?",
                                            master=self.tkroot)
            if ans is None:
                return False
            if ans:
                self.save_all()
                return self.dirty_count() == 0
            return True
        if pygame.time.get_ticks() < self.quit_armed:
            return True
        self.quit_armed = pygame.time.get_ticks() + 10000
        self.say(f"{n} unsaved screen file(s) - press S to save, or do it again to discard", 9000)
        return False

    def open_dialog(self):
        if not self.maybe_save_first():
            return
        path = self.ask_folder()
        if path:
            self.open_project(path)

    def import_image(self):
        if not self.editable():
            return
        path = self.ask_image()
        if not path:
            return
        try:
            surf = pygame.image.load(path).convert_alpha()
            w, h = surf.get_size()
            if w * h > MAX_IMPORT_PIXELS:
                self.say(f"Image is too big ({w}x{h})")
                return
            data = quantize_rgba(_tobytes(surf, "RGBA"))
        except Exception as e:
            self.say(f"Failed to import image: {e}")
            return
        self.clipboard = {"w": w, "h": h, "data": data}
        self.start_paste()

    # ---------------------------------------------------------- events
    def handle_event(self, e):
        if e.type == pygame.QUIT:
            if self.maybe_save_first():
                self.running = False
            return
        if e.type == pygame.VIDEORESIZE:
            self.screen = pygame.display.set_mode((max(e.w, UI_WIDTH + 400), max(e.h, 700)), pygame.RESIZABLE)
            self.clamp_camera()
        elif e.type == pygame.KEYDOWN:
            self.on_key(e)
        elif e.type == pygame.MOUSEBUTTONDOWN:
            self.mouse = e.pos
            self.on_mouse_down(e)
        elif e.type == pygame.MOUSEBUTTONUP:
            self.mouse = e.pos
            self.on_mouse_up(e)
        elif e.type == pygame.MOUSEMOTION:
            self.mouse = e.pos
            self.on_motion(e)
        elif e.type == pygame.MOUSEWHEEL:
            self.on_wheel(e)
        elif e.type == pygame.DROPFILE:
            if os.path.isdir(e.file) and self.maybe_save_first():
                self.open_project(e.file)

    def on_key(self, e):
        k, mods = e.key, e.mod
        ctrl, shift = mods & pygame.KMOD_CTRL, mods & pygame.KMOD_SHIFT
        m = self.map
        if k == pygame.K_F1:
            self.show_help = not self.show_help
        elif k == pygame.K_s:
            self.save_all()
        elif ctrl and k == pygame.K_z:
            self.do_undo(redo=bool(shift))
        elif ctrl and k == pygame.K_y:
            self.do_undo(redo=True)
        elif ctrl and k == pygame.K_c:
            self.copy_selection()
        elif ctrl and k == pygame.K_x:
            self.cut_selection()
        elif ctrl and k == pygame.K_v:
            self.start_paste()
        elif ctrl:
            pass
        elif k == pygame.K_t:
            self.tool = TOOLS[(TOOLS.index(self.tool) + 1) % len(TOOLS)]
            self.say(f"Tool: {self.tool}", 1500)
        elif k == pygame.K_i:
            self.import_image()
        elif k == pygame.K_o:
            self.open_dialog()
        elif k == pygame.K_F5:
            if self.root and self.maybe_save_first():
                self.open_project(self.root)
        elif k == pygame.K_g:
            self.show_grid = not self.show_grid
        elif k == pygame.K_b:
            self.checker_bg = not self.checker_bg
        elif k == pygame.K_f:
            self.fit_view()
        elif k == pygame.K_v and self.layer:
            self.layer.visible = not self.layer.visible
        elif k == pygame.K_e:
            self.color = (self.color + 1) % 256
        elif k == pygame.K_q:
            self.color = (self.color - 1) % 256
        elif k == pygame.K_LEFTBRACKET and m and m.layers:
            self.set_layer((m.active - 1) % len(m.layers))
        elif k == pygame.K_RIGHTBRACKET and m and m.layers:
            self.set_layer((m.active + 1) % len(m.layers))
        elif pygame.K_1 <= k <= pygame.K_9:
            self.set_layer(k - pygame.K_1)
        elif k in (pygame.K_EQUALS, pygame.K_PLUS, pygame.K_KP_PLUS):
            self.step_zoom(1)
        elif k in (pygame.K_MINUS, pygame.K_KP_MINUS):
            self.step_zoom(-1)
        elif k == pygame.K_PAGEUP:
            self.switch_map(self.mi - 1)
        elif k == pygame.K_PAGEDOWN:
            self.switch_map(self.mi + 1)
        elif k in (pygame.K_LEFT, pygame.K_RIGHT, pygame.K_UP, pygame.K_DOWN):
            step = 96
            self.ox += step if k == pygame.K_LEFT else -step if k == pygame.K_RIGHT else 0
            self.oy += step if k == pygame.K_UP else -step if k == pygame.K_DOWN else 0
            self.clamp_camera()
        elif k == pygame.K_RETURN:
            if self.is_pasting:
                self.commit_paste()
        elif k == pygame.K_DELETE:
            if self.selection_box and self.editable():
                self.clear_selection_pixels()
        elif k == pygame.K_ESCAPE:
            if self.is_pasting:
                self.is_pasting = False
                self.say("Paste canceled", 1500)
            elif self.is_moving:
                self.commit_move()
            else:
                self.selection_box = self.selection_start = None

    def on_mouse_down(self, e):
        L = self.layout()
        pos, btn = e.pos, e.button
        if btn in (2, 3) and L["view"].collidepoint(pos):
            self.panning = True
            return
        if btn != 1:
            return
        if L["vbar"].collidepoint(pos):
            self.drag_bar = "v"
            self.drag_scroll("v", pos[1])
        elif L["hbar"].collidepoint(pos):
            self.drag_bar = "h"
            self.drag_scroll("h", pos[0])
        elif L["view"].collidepoint(pos):
            self.canvas_click(pos)
        elif pos[0] >= L["ux"]:
            self.sidebar_click(pos, L)

    def canvas_click(self, pos):
        if not self.map or self.show_help:
            return
        wx, wy = self.to_world(pos)
        mods = self.mods()
        tool = self.tool
        if self.selection_box and (mods & pygame.KMOD_CTRL) and (mods & pygame.KMOD_ALT) \
                and not self.is_pasting and not self.is_moving:
            self.start_move(wx, wy)
        elif self.is_pasting:
            self.commit_paste()
        elif tool == "select":
            self.selection_start = (wx, wy)
            self.selection_box = None
            self.update_selection(pos)
        elif tool == "picker":
            self.pick_color(wx, wy)
        elif not self.editable():
            return
        elif tool in ("draw", "eraser"):
            self.map.begin()
            self.stroking = True
            self.last = None
            self.stroke_to(wx, wy)
        elif tool == "bucket":
            self.do_fill(wx, wy)

    def sidebar_click(self, pos, L):
        pal = L["pal"]
        if pal.collidepoint(pos):
            c = L["cell"]
            self.color = ((pos[1] - pal.y) // c) * 16 + (pos[0] - pal.x) // c
            return
        for i, r, eye in L["layer_rows"]:
            if r.collidepoint(pos):
                if eye.collidepoint(pos):
                    self.map.layers[i].visible = not self.map.layers[i].visible
                else:
                    self.set_layer(i)
                return
        for i, r in L["map_rows"]:
            if r.collidepoint(pos):
                self.switch_map(i)
                return
        actions = [self.open_dialog, self.import_image, self.save_all]
        for r, act in zip(L["buttons"], actions):
            if r.collidepoint(pos):
                act()
                return

    def on_mouse_up(self, e):
        if e.button in (2, 3):
            self.panning = False
        elif e.button == 1:
            self.drag_bar = None
            if self.is_moving:
                self.commit_move()
            elif self.stroking:
                self.stroking = False
                self.last = None
                self.map.end()
            elif self.tool == "select" and self.selection_start:
                self.update_selection(e.pos)
                self.selection_start = None

    def on_motion(self, e):
        if self.drag_bar:
            self.drag_scroll(self.drag_bar, e.pos[1] if self.drag_bar == "v" else e.pos[0])
        elif self.panning:
            self.ox += e.rel[0]
            self.oy += e.rel[1]
            self.clamp_camera()
        elif self.is_moving:
            wx, wy = self.to_world(e.pos)
            self.move_x, self.move_y = wx - self.grab_ox, wy - self.grab_oy
        elif self.is_pasting:
            self.paste_x, self.paste_y = self.to_world(e.pos)
        elif self.stroking:
            self.stroke_to(*self.to_world(e.pos))
        elif self.selection_start and self.tool == "select":
            self.update_selection(e.pos)

    def on_wheel(self, e):
        L = self.layout()
        if not L["view"].collidepoint(self.mouse):
            return
        mods = self.mods()
        if mods & pygame.KMOD_CTRL:
            self.step_zoom(1 if e.y > 0 else -1 if e.y < 0 else 0, self.mouse)
            return
        if mods & pygame.KMOD_SHIFT:
            self.ox += e.y * 35
        else:
            self.oy += e.y * 35
        self.ox -= e.x * 35
        self.clamp_camera()

    # ---------------------------------------------------------- drawing
    def text(self, s, pos, color=(200, 200, 200), font=None):
        self.screen.blit((font or self.font).render(s, True, color), pos)

    def clip_text(self, s, width):
        if self.font.size(s)[0] <= width:
            return s
        while s and self.font.size(s + "...")[0] > width:
            s = s[:-1]
        return s + "..."

    def blit_crop(self, surf, sx, sy, w, h):
        """Blit an (integer zoom >= 1) scaled copy of just the part of `surf` that is on screen."""
        z = self.zoom
        view = self.layout()["view"]
        ix0, iy0 = max(0, (view.left - sx) // z), max(0, (view.top - sy) // z)
        ix1, iy1 = min(w, -((sx - view.right) // z)), min(h, -((sy - view.bottom) // z))
        if ix1 <= ix0 or iy1 <= iy0:
            return
        sub = surf.subsurface((ix0, iy0, ix1 - ix0, iy1 - iy0))
        self.screen.blit(pygame.transform.scale(sub, ((ix1 - ix0) * z, (iy1 - iy0) * z)),
                         (sx + ix0 * z, sy + iy0 * z))

    def blit_world(self, surf, wx, wy):
        w, h = surf.get_size()
        sx, sy = self.to_screen(wx, wy)
        if self.zoom >= 1:
            self.blit_crop(surf, sx, sy, w, h)
        else:
            sc = pygame.transform.scale(surf, (max(1, int(w * self.zoom)), max(1, int(h * self.zoom))))
            self.screen.blit(sc, (sx, sy))

    def data_surface(self, data, w, h):
        key = (id(data), w, h)
        if not self._ghost or self._ghost[0] != key:
            s = pygame.image.frombuffer(data, (w, h), "P")
            s.set_palette(palette_rgb)
            s.set_colorkey(0)
            self._ghost = (key, s, data)
        return self._ghost[1]

    def checker_surface(self):
        if self._checker is None:
            buf = bytes(1 if ((i % TILE_W) // 8 + (i // TILE_W) // 8) % 2 else 0 for i in range(TILE_BYTES))
            s = pygame.image.frombuffer(buf, (TILE_W, TILE_H), "P")
            s.set_palette([(58, 58, 58), (88, 88, 88)] + [(0, 0, 0)] * 254)
            self._checker = (s, buf)
        return self._checker[0]

    def visible_cells(self, view):
        z = self.zoom
        cw, ch = TILE_W * z, TILE_H * z
        x0 = max(0, int((view.left - self.ox) // cw))
        y0 = max(0, int((view.top - self.oy) // ch))
        x1 = min(MAX_CELL, int((view.right - self.ox) // cw))
        y1 = min(MAX_CELL, int((view.bottom - self.oy) // ch))
        return x0, y0, x1, y1

    def draw_canvas(self, L):
        scr, view, z = self.screen, L["view"], self.zoom
        scr.set_clip(view)
        scr.fill((25, 25, 25))
        m = self.map
        if m is None:
            self.text("Press O (or the button) to open a project folder", (30, 30), (220, 220, 220), self.font_bold)
            scr.set_clip(None)
            return
        vx0, vy0, vx1, vy1 = self.visible_cells(view)
        bb = m.cells_bbox()
        if bb:
            bx, by = self.to_screen(bb[0] * TILE_W, bb[1] * TILE_H)
            bw, bh = int((bb[2] - bb[0] + 1) * TILE_W * z), int((bb[3] - bb[1] + 1) * TILE_H * z)
            pygame.draw.rect(scr, (0, 0, 0), (bx, by, bw, bh))
            if self.checker_bg:
                chk = self.checker_surface()
                for cy in range(max(vy0, bb[1]), min(vy1, bb[3]) + 1):
                    for cx in range(max(vx0, bb[0]), min(vx1, bb[2]) + 1):
                        self.blit_world(chk, cx * TILE_W, cy * TILE_H)
        for layer in m.layers:
            if not layer.visible:
                continue
            for cy in range(vy0, vy1 + 1):
                for cx in range(vx0, vx1 + 1):
                    t = layer.tiles.get((cx, cy))
                    if t is None:
                        continue
                    sx, sy = self.to_screen(cx * TILE_W, cy * TILE_H)
                    if z < 1:
                        scr.blit(t.scaled(z), (sx, sy))
                    else:
                        self.blit_crop(t.surface(), sx, sy, TILE_W, TILE_H)
        if self.show_grid:
            self.draw_grid(L, bb, vx0, vy0, vx1, vy1)
        # paste / move ghosts
        if self.is_pasting and self.clipboard:
            c = self.clipboard
            self.blit_world(self.data_surface(c["data"], c["w"], c["h"]), self.paste_x, self.paste_y)
            sx, sy = self.to_screen(self.paste_x, self.paste_y)
            pygame.draw.rect(scr, (255, 255, 255), (sx, sy, int(c["w"] * z), int(c["h"] * z)), 1)
            self.size_label(sx, sy, c["w"], c["h"], (255, 255, 255))
        if self.is_moving and self.move_buffer:
            b = self.move_buffer
            self.blit_world(self.data_surface(b["data"], b["w"], b["h"]), self.move_x, self.move_y)
            sx, sy = self.to_screen(self.move_x, self.move_y)
            pygame.draw.rect(scr, (255, 180, 0), (sx, sy, int(b["w"] * z), int(b["h"] * z)), 2)
            self.size_label(sx, sy, b["w"], b["h"], (255, 180, 0))
        if self.selection_box and not self.is_pasting and not self.is_moving:
            x, y, w, h = self.selection_box
            sx, sy = self.to_screen(x, y)
            pygame.draw.rect(scr, (0, 255, 255), (sx, sy, max(2, int(w * z)), max(2, int(h * z))), 2)
            self.size_label(sx, sy, w, h, (0, 255, 255))
        # pixel cursor
        if view.collidepoint(self.mouse) and not (self.is_pasting or self.is_moving):
            wx, wy = self.to_world(self.mouse)
            if wx >= 0 and wy >= 0:
                sx, sy = self.to_screen(wx, wy)
                col = {"draw": (255, 255, 0), "eraser": (255, 0, 255), "bucket": (0, 150, 255),
                       "picker": (0, 255, 128)}.get(self.tool, (0, 255, 255))
                size = max(2, int(z))
                pygame.draw.rect(scr, col, (sx, sy, size, size), 1)
        scr.set_clip(None)
        self.draw_scrollbars(L)
        # status line
        if self.status and pygame.time.get_ticks() < self.status_until:
            t = self.font.render(self.status, True, (255, 255, 255))
            r = t.get_rect(bottomleft=(8, view.bottom - 6))
            r = r.clip(view) if r.width > view.w - 16 else r
            pygame.draw.rect(scr, (20, 20, 20), r.inflate(10, 6))
            scr.blit(t, r, area=pygame.Rect(0, 0, view.w - 20, r.h))

    def draw_grid(self, L, bb, vx0, vy0, vx1, vy1):
        scr, z = self.screen, self.zoom
        if bb is None:
            bb = (0, 0, 0, 0)
        gx0, gy0 = max(0, bb[0] - 1), max(0, bb[1] - 1)
        gx1, gy1 = min(MAX_CELL, bb[2] + 1), min(MAX_CELL, bb[3] + 1)
        cw, ch = TILE_W * z, TILE_H * z
        left, top = self.to_screen(gx0 * TILE_W, gy0 * TILE_H)
        right, bottom = self.to_screen((gx1 + 1) * TILE_W, (gy1 + 1) * TILE_H)
        for cx in range(gx0, gx1 + 2):
            x = int(left + (cx - gx0) * cw)
            pygame.draw.line(scr, (70, 70, 110), (x, top), (x, bottom))
        for cy in range(gy0, gy1 + 2):
            y = int(top + (cy - gy0) * ch)
            pygame.draw.line(scr, (70, 70, 110), (left, y), (right, y))
        if self.map.cells_bbox():
            bx, by = self.to_screen(bb[0] * TILE_W, bb[1] * TILE_H)
            pygame.draw.rect(scr, (120, 120, 210), (bx, by, int((bb[2] - bb[0] + 1) * cw), int((bb[3] - bb[1] + 1) * ch)), 2)
        layer = self.layer
        if cw >= 34:
            for cy in range(max(vy0, gy0), min(vy1, gy1) + 1):
                for cx in range(max(vx0, gx0), min(vx1, gx1) + 1):
                    has = layer is not None and (cx, cy) in layer.tiles
                    sx, sy = self.to_screen(cx * TILE_W, cy * TILE_H)
                    t = self.font_small.render(f"{cx},{cy}", True, (255, 220, 80) if has else (130, 130, 130))
                    pygame.draw.rect(scr, (20, 20, 20), (sx + 2, sy + 2, t.get_width() + 6, t.get_height() + 2))
                    scr.blit(t, (sx + 5, sy + 3))
        # highlight the screen under the mouse
        if L["view"].collidepoint(self.mouse):
            wx, wy = self.to_world(self.mouse)
            if wx >= 0 and wy >= 0 and wx // TILE_W <= MAX_CELL and wy // TILE_H <= MAX_CELL:
                sx, sy = self.to_screen((wx // TILE_W) * TILE_W, (wy // TILE_H) * TILE_H)
                pygame.draw.rect(scr, (0, 200, 255), (sx, sy, int(cw), int(ch)), 1)

    def size_label(self, x, y, w, h, color):
        surf = self.font_small.render(f"{w}x{h}", True, color)
        r = surf.get_rect(topleft=(x, y - 18)).inflate(6, 4)
        pygame.draw.rect(self.screen, (20, 20, 20), r)
        pygame.draw.rect(self.screen, color, r, 1)
        self.screen.blit(surf, (r.x + 3, r.y + 2))

    def draw_scrollbars(self, L):
        scr = self.screen
        for axis, rect in (("v", L["vbar"]), ("h", L["hbar"])):
            pygame.draw.rect(scr, (35, 35, 35), rect)
            g = self.bar_geom(axis) if self.map else None
            if g:
                track, thumb, frac, *_ = g
                off = int(frac * (track - thumb))
                tr = (rect.x + 2, rect.y + off + 2, rect.w - 4, thumb - 4) if axis == "v" \
                    else (rect.x + off + 2, rect.y + 2, thumb - 4, rect.h - 4)
                pygame.draw.rect(scr, (100, 100, 100), tr, border_radius=3)
        pygame.draw.rect(scr, (30, 30, 30), (L["ux"] - SB, L["h"] - SB, SB, SB))

    def draw_sidebar(self, L):
        scr = self.screen
        ux, h = L["ux"], L["h"]
        pygame.draw.rect(scr, (40, 40, 40), (ux, 0, UI_WIDTH, h))
        pygame.draw.line(scr, (80, 80, 80), (ux, 0), (ux, h), 2)
        m, layer = self.map, self.layer
        bx = ux + 15
        wx = wy = None
        if L["view"].collidepoint(self.mouse):
            wx, wy = self.to_world(self.mouse)
        lines = [
            f"Project: {os.path.basename(self.root) or self.root}" if self.root else "Project: (none - press O)",
            f"Map: {m.name}  ({self.mi + 1}/{len(self.maps)})" if m else "Map: -",
            f"Layer: .{layer.disp}{'  (HIDDEN)' if not layer.visible else ''}" if layer else "Layer: -",
            f"Tool: {self.tool.upper()} (T)",
            f"Color: {self.color} (0x{self.color:02X}){'  = transparent' if self.color == 0 else ''}",
            f"Zoom: {self.zoom:g}x",
            "Cursor: -", "Screen: -", "File: -", "Pixel: -",
        ]
        if wx is not None and wx >= 0 and wy >= 0:
            cx, cy = wx // TILE_W, wy // TILE_H
            lines[6] = f"Cursor: world {wx},{wy}"
            lines[7] = f"Screen: {cx},{cy}   local {wx % TILE_W},{wy % TILE_H}"
            if layer and m:
                has = (cx, cy) in layer.tiles
                lines[8] = f"File: {cx},{cy}.{layer.disp}  " + ("exists" if has else "none yet (made on paint)")
                seen = 0
                for l in reversed(m.layers):
                    if l.visible and m.get_px(l, wx, wy):
                        seen = m.get_px(l, wx, wy)
                        break
                lines[9] = f"Pixel: 0x{m.get_px(layer, wx, wy):02X} layer, 0x{seen:02X} seen"
        lines.append(f"Unsaved: {self.dirty_count()} file(s)")
        lines.append("F1 = all controls")
        for i, t in enumerate(lines):
            self.text(self.clip_text(t, UI_WIDTH - 30), (bx, 12 + i * 17), (255, 255, 255) if i < 4 else (200, 200, 200))
        if m:
            self.text("Layers (click = edit, box = show):", (bx, L["layers_hdr"]), (150, 150, 150))
            for i, r, eye in L["layer_rows"]:
                l = m.layers[i]
                if i == m.active:
                    pygame.draw.rect(scr, (60, 80, 110), r)
                pygame.draw.rect(scr, (200, 200, 200), (eye.x + 3, eye.y + 3, 11, 11), 1)
                if l.visible:
                    pygame.draw.rect(scr, (120, 220, 120), (eye.x + 5, eye.y + 5, 7, 7))
                n_dirty = sum(1 for t in l.tiles.values() if t.dirty)
                self.text(self.clip_text(f"{i + 1}  .{l.disp}   {len(l.tiles)} screens" + (f"  ({n_dirty} unsaved)" if n_dirty else ""), r.w - 30),
                          (r.x + 26, r.y + 1), (255, 255, 255) if i == m.active else (200, 200, 200))
        if L["map_rows"]:
            self.text(f"Maps (click, PgUp/PgDn)  {L['map_first'] + 1}-{L['map_first'] + len(L['map_rows'])} of {L['map_n']}",
                      (bx, L["maps_hdr"]), (150, 150, 150))
            for i, r in L["map_rows"]:
                if i == self.mi:
                    pygame.draw.rect(scr, (60, 80, 110), r)
                mp = self.maps[i]
                d = mp.dirty_count()
                self.text(self.clip_text(mp.name + (f"  ({d} unsaved)" if d else ""), r.w - 8), (r.x + 4, r.y + 1),
                          (255, 255, 255) if i == self.mi else (200, 200, 200))
        pal, c = L["pal"], L["cell"]
        for i in range(256):
            r = pygame.Rect(pal.x + (i % 16) * c, pal.y + (i // 16) * c, c - 1, c - 1)
            pygame.draw.rect(scr, palette_rgb[i], r)
        pygame.draw.rect(scr, (255, 255, 255),
                         (pal.x + (self.color % 16) * c - 1, pal.y + (self.color // 16) * c - 1, c + 1, c + 1), 2)
        for (label, col), r in zip((("OPEN FOLDER (O)", (70, 130, 70)), ("IMPORT IMAGE (I)", (130, 70, 140)),
                                    ("SAVE ALL (S)", (70, 70, 140))), L["buttons"]):
            pygame.draw.rect(scr, col, r, border_radius=4)
            pygame.draw.rect(scr, (200, 200, 200), r, 1, border_radius=4)
            t = self.font.render(label, True, (255, 255, 255))
            scr.blit(t, t.get_rect(center=r.center))

    def draw_help(self, L):
        panel = pygame.Rect(0, 0, 640, 30 + len(HELP_LINES) * 20)
        panel.center = L["view"].center
        veil = pygame.Surface(panel.size, pygame.SRCALPHA)
        veil.fill((15, 15, 25, 235))
        self.screen.blit(veil, panel)
        pygame.draw.rect(self.screen, (120, 120, 200), panel, 1)
        for i, line in enumerate(HELP_LINES):
            self.text(line, (panel.x + 16, panel.y + 15 + i * 20), (255, 255, 255) if i == 0 else (215, 215, 215))

    def draw(self):
        L = self.layout()
        self.draw_canvas(L)
        self.draw_sidebar(L)
        if self.show_help:
            self.draw_help(L)
        cap = "worldr" + (f" - {os.path.basename(self.root)} / {self.map.name}" if self.map else "")
        if self.dirty_count():
            cap += " *"
        if cap != self._caption:
            pygame.display.set_caption(cap)
            self._caption = cap
        pygame.display.flip()

    # ---------------------------------------------------------- main loop
    def startup(self, path):
        if path:
            self.open_project(path)
            return
        if self.open_project(os.getcwd()):
            return
        p = self.ask_folder()
        if p:
            self.open_project(p)

    def run(self):
        while self.running:
            for e in pygame.event.get():
                self.handle_event(e)
            m = self.map
            if m and m.cur is not None and not (self.stroking or self.is_moving):
                m.end()                     # a mouse-up we never saw (released outside the window)
            if self.tkroot:
                try:
                    self.tkroot.update()
                except tk.TclError:
                    pass
            self.draw()
            self.clock.tick(60)
        pygame.quit()


def main():
    app = App()
    app.startup(sys.argv[1] if len(sys.argv) > 1 else None)
    app.run()


if __name__ == "__main__":
    main()
