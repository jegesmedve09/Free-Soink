import pygame
import sys
import tkinter as tk
from tkinter import filedialog

pygame.init()

root = tk.Tk()
root.withdraw()
root.update()

WIDTH, HEIGHT = 320, 224
TILE_SIZE = 40
COLS = WIDTH // TILE_SIZE  # 8 columns
ROWS = HEIGHT // TILE_SIZE # 5 rows

UI_WIDTH = 380
WIN_WIDTH = (WIDTH * 2) + UI_WIDTH
WIN_HEIGHT = 720

screen = pygame.display.set_mode((WIN_WIDTH, WIN_HEIGHT), pygame.RESIZABLE)
pygame.display.set_caption("Green Mountain Zone - Retro Level Animation Player")
clock = pygame.time.Clock()

# ---------- Palette ----------
raw_data = """
000 020 040 060 080 0A0 0C0 0E0
002 022 042 062 082 0A2 0C2 0E2
004 024 044 064 084 0A4 0C4 0E4
006 026 046 066 086 0A6 0C6 0E6
008 028 048 068 088 0A8 0C8 0E8
00A 02A 04A 06A 08A 0AA 0CA 0EA
00C 02C 04C 06C 08C 0AC 0CC 0EC
00E 02E 04E 06E 08E 0AE 0CE 0EE
400 420 440 460 480 4A0 4C0 4E0
402 422 442 462 482 4A2 4C2 4E2
404 424 444 464 484 4A4 4C4 4E4
406 426 446 466 486 4A6 4C6 4E6
408 428 448 468 488 4A8 4C8 4E8
40A 42A 44A 46A 48A 4AA 4CA 4EA
40C 42C 44C 46C 48C 4AC 4CC 4EC
40E 42E 44E 46E 48E 4AE 4CE 4EE
800 820 840 860 880 8A0 8C0 8E0
802 822 842 862 882 8A2 8C2 8E2
804 824 844 864 884 8A4 8C4 8E4
806 826 846 866 886 8A6 8C6 8E6
808 828 848 868 888 8A8 8C8 8E8
80A 82A 84A 86A 88A 8AA 8CA 8EA
80C 82C 84C 86C 88C 8AC 8CC 8EC
80E 82E 84E 86E 88E 8AE 8CE 8EE
C00 C20 C40 C60 C80 CA0 CC0 CE0
C02 C22 C42 C62 C82 CA2 CC2 CE2
C04 C24 C44 C64 C84 CA4 CC4 CE4
C06 C26 C46 C66 C86 CA6 CC6 CE6
C08 C28 C48 C68 C88 CA8 CC8 CE8
C0A C2A C4A C6A C8A CAA CCA CEA
C0C C2C C4C C6C C8C CAC CCC CEC
C0E C2E C4E C6E C8E CAE CCE CEE
"""
tokens = raw_data.split()
palette_rgb = []
for token in tokens:
    r = int(token[0], 16) << 4
    g = int(token[1], 16) << 4
    b = int(token[2], 16) << 4
    palette_rgb.append((r, g, b))
while len(palette_rgb) < 256:
    palette_rgb.append((0, 0, 0))

# ---------- Animation State ----------
canvas_data = bytearray(WIDTH * HEIGHT)
current_filename = "0,0.lvl"

animation_sequence = [0, 1, 2, 3, 4, 5]
sequence_input_str = "0,1,2,3,4,5"
is_input_active = False

fps = 6
anim_timer = 0.0
current_anim_index = 0
is_playing = True
anim_zoom = 4 

font = pygame.font.SysFont(None, 20)
font_bold = pygame.font.SysFont(None, 22, bold=True)
font_small = pygame.font.SysFont(None, 16)

canvas_surf = pygame.Surface((WIDTH, HEIGHT))

def rebuild_canvas_surf():
    pxarray = pygame.PixelArray(canvas_surf)
    for y in range(HEIGHT):
        for x in range(WIDTH):
            idx = canvas_data[y * WIDTH + x]
            pxarray[x, y] = palette_rgb[idx]
    del pxarray

def parse_sequence_string(s):
    global animation_sequence
    try:
        parsed = [int(item.strip()) for item in s.split(",") if item.strip()]
        if parsed:
            animation_sequence = parsed
    except ValueError:
        pass # Keep previous valid sequence if typing is incomplete

def open_level_dialog():
    global canvas_data, current_filename
    filepath = filedialog.askopenfilename(
        master=root,
        title="Open Level File",
        defaultextension=".lvl",
        filetypes=[("Level Files", "*.lvl"), ("All Files", "*.*")]
    )
    if filepath:
        try:
            with open(filepath, "rb") as f:
                data = f.read()
                if len(data) == WIDTH * HEIGHT:
                    canvas_data = bytearray(data)
                    current_filename = filepath
                    rebuild_canvas_surf()
                    print(f"Successfully loaded: {filepath}")
                else:
                    print(f"Error: Size mismatch! Expected {WIDTH*HEIGHT} bytes, got {len(data)}.")
        except Exception as e:
            print(f"Failed to open file: {e}")

# Initial setup
rebuild_canvas_surf()
try:
    with open(current_filename, "rb") as f:
        data = f.read()
        if len(data) == WIDTH * HEIGHT:
            canvas_data = bytearray(data)
            rebuild_canvas_surf()
except FileNotFoundError:
    pass

running = True
while running:
    dt = clock.tick(60) / 1000.0
    mouse_x, mouse_y = pygame.mouse.get_pos()
    w_width, w_height = screen.get_size()
    ui_start_x = w_width - UI_WIDTH

    # UI Element Rects
    btn_y_start = w_height - 235
    open_btn_rect = pygame.Rect(ui_start_x + 15, btn_y_start, UI_WIDTH - 30, 32)
    play_btn_rect = pygame.Rect(ui_start_x + 15, btn_y_start + 40, UI_WIDTH - 30, 32)
    speed_minus_rect = pygame.Rect(ui_start_x + 15, btn_y_start + 80, (UI_WIDTH - 35) // 2, 32)
    speed_plus_rect = pygame.Rect(ui_start_x + 20 + (UI_WIDTH - 35) // 2, btn_y_start + 80, (UI_WIDTH - 35) // 2, 32)
    input_box_rect = pygame.Rect(ui_start_x + 15, btn_y_start + 150, UI_WIDTH - 30, 32)

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

        elif event.type == pygame.VIDEORESIZE:
            screen = pygame.display.set_mode((max(event.w, UI_WIDTH + 400), max(event.h, 550)), pygame.RESIZABLE)

        elif event.type == pygame.KEYDOWN:
            if is_input_active:
                if event.key == pygame.K_RETURN:
                    is_input_active = False
                    parse_sequence_string(sequence_input_str)
                elif event.key == pygame.K_BACKSPACE:
                    sequence_input_str = sequence_input_str[:-1]
                    parse_sequence_string(sequence_input_str)
                else:
                    if event.unicode and (event.unicode.isdigit() or event.unicode in [',', ' ']):
                        sequence_input_str += event.unicode
                        parse_sequence_string(sequence_input_str)
            else:
                if event.key == pygame.K_o:
                    open_level_dialog()
                elif event.key == pygame.K_SPACE:
                    is_playing = not is_playing

        elif event.type == pygame.MOUSEBUTTONDOWN:
            if event.button == 1:
                if mouse_x >= ui_start_x:
                    if open_btn_rect.collidepoint(mouse_x, mouse_y):
                        open_level_dialog()
                        is_input_active = False
                    elif play_btn_rect.collidepoint(mouse_x, mouse_y):
                        is_playing = not is_playing
                        is_input_active = False
                    elif speed_minus_rect.collidepoint(mouse_x, mouse_y):
                        fps = max(1, fps - 1)
                        is_input_active = False
                    elif speed_plus_rect.collidepoint(mouse_x, mouse_y):
                        fps = min(60, fps + 1)
                        is_input_active = False
                    elif input_box_rect.collidepoint(mouse_x, mouse_y):
                        is_input_active = True
                    else:
                        is_input_active = False
                else:
                    is_input_active = False

    # ---------- Animation Frame Logic ----------
    if is_playing and animation_sequence and fps > 0:
        anim_timer += dt
        frame_duration = 1.0 / fps
        if anim_timer >= frame_duration:
            anim_timer = 0.0
            current_anim_index = (current_anim_index + 1) % len(animation_sequence)

    try:
        root.update()
    except tk.TclError:
        pass

    # ---------- Rendering ----------
    screen.fill((25, 25, 25))

    # 1. Spritesheet View (Left Side)
    sheet_scale = 2
    sheet_render_w = WIDTH * sheet_scale
    sheet_render_h = HEIGHT * sheet_scale
    scaled_sheet = pygame.transform.scale(canvas_surf, (sheet_render_w, sheet_render_h))
    screen.blit(scaled_sheet, (20, 20))

    # Grid & Tile Indices overlay
    for r in range(ROWS):
        for c in range(COLS):
            tile_idx = r * COLS + c
            rect = pygame.Rect(20 + c * TILE_SIZE * sheet_scale, 20 + r * TILE_SIZE * sheet_scale, TILE_SIZE * sheet_scale, TILE_SIZE * sheet_scale)
            pygame.draw.rect(screen, (70, 70, 70), rect, 1)
            idx_txt = font_small.render(str(tile_idx), True, (200, 200, 200))
            screen.blit(idx_txt, (rect.x + 4, rect.y + 4))

    sheet_bottom = 20 + sheet_render_h + 15

    # 2. Live Animation Preview Box
    preview_box_w = TILE_SIZE * anim_zoom
    preview_box_h = TILE_SIZE * anim_zoom
    preview_x = 20 + (sheet_render_w - preview_box_w) // 2
    preview_y = sheet_bottom + 10

    pygame.draw.rect(screen, (40, 40, 40), (preview_x - 4, preview_y - 4, preview_box_w + 8, preview_box_h + 8), border_radius=6)
    pygame.draw.rect(screen, (100, 100, 100), (preview_x - 4, preview_y - 4, preview_box_w + 8, preview_box_h + 8), 1, border_radius=6)

    if animation_sequence:
        safe_idx_pos = current_anim_index % len(animation_sequence)
        tile_id = animation_sequence[safe_idx_pos]
        t_col = tile_id % COLS
        t_row = tile_id // COLS
        
        if 0 <= t_row < ROWS and 0 <= t_col < COLS:
            tile_surf = pygame.Surface((TILE_SIZE, TILE_SIZE))
            tile_surf.blit(canvas_surf, (0, 0), (t_col * TILE_SIZE, t_row * TILE_SIZE, TILE_SIZE, TILE_SIZE))
            scaled_tile = pygame.transform.scale(tile_surf, (preview_box_w, preview_box_h))
            screen.blit(scaled_tile, (preview_x, preview_y))
        else:
            err_txt = font.render("Invalid Tile ID", True, (255, 100, 100))
            screen.blit(err_txt, (preview_x + 10, preview_y + 50))

    prev_label = font.render(f"Live Preview (Frame {current_anim_index + 1}/{len(animation_sequence)})", True, (220, 220, 220))
    screen.blit(prev_label, (20, sheet_bottom - 10))

    # 3. UI Sidebar
    pygame.draw.rect(screen, (35, 35, 35), (ui_start_x, 0, UI_WIDTH, w_height))
    pygame.draw.line(screen, (80, 80, 80), (ui_start_x, 0), (ui_start_x, w_height), 2)

    short_filename = current_filename.split("/")[-1].split("\\")[-1]
    active_tile = animation_sequence[current_anim_index % len(animation_sequence)] if animation_sequence else 0

    ui_texts = [
        f"File: {short_filename}",
        f"Resolution: {WIDTH}x{HEIGHT} ({COLS}x{ROWS} grid)",
        f"Tile Size: {TILE_SIZE}x{TILE_SIZE}px",
        f"Playback Speed: {fps} FPS",
        f"Status: {'Playing' if is_playing else 'Paused'}",
        f"Active Frame Index: {current_anim_index}",
        f"Current Tile ID: {active_tile}"
    ]

    for i, text in enumerate(ui_texts):
        color = (255, 255, 255) if i in [0, 4, 6] else (200, 200, 200)
        screen.blit(font.render(text, True, color), (ui_start_x + 15, 15 + i * 22))

    # Draw Control Buttons & Inputs
    # 1. Open File Button
    pygame.draw.rect(screen, (70, 130, 70), open_btn_rect, border_radius=4)
    pygame.draw.rect(screen, (200, 200, 200), open_btn_rect, 1, border_radius=4)
    txt = font_bold.render("OPEN .LVL FILE (O)", True, (255, 255, 255))
    screen.blit(txt, txt.get_rect(center=open_btn_rect.center))

    # 2. Play / Pause Button
    pygame.draw.rect(screen, (140, 100, 50), play_btn_rect, border_radius=4)
    pygame.draw.rect(screen, (200, 200, 200), play_btn_rect, 1, border_radius=4)
    txt = font_bold.render("PLAY / PAUSE (SPACE)", True, (255, 255, 255))
    screen.blit(txt, txt.get_rect(center=play_btn_rect.center))

    # 3. Speed - and Speed + Buttons
    pygame.draw.rect(screen, (90, 90, 90), speed_minus_rect, border_radius=4)
    pygame.draw.rect(screen, (200, 200, 200), speed_minus_rect, 1, border_radius=4)
    txt = font_bold.render("SPEED -", True, (255, 255, 255))
    screen.blit(txt, txt.get_rect(center=speed_minus_rect.center))

    pygame.draw.rect(screen, (90, 90, 90), speed_plus_rect, border_radius=4)
    pygame.draw.rect(screen, (200, 200, 200), speed_plus_rect, 1, border_radius=4)
    txt = font_bold.render("SPEED +", True, (255, 255, 255))
    screen.blit(txt, txt.get_rect(center=speed_plus_rect.center))

    # 4. Sequence Label & Text Box
    seq_label = font.render("Render Sequence (Comma separated):", True, (200, 200, 200))
    screen.blit(seq_label, (ui_start_x + 15, btn_y_start + 125))

    box_color = (60, 60, 60) if not is_input_active else (80, 80, 120)
    border_color = (150, 150, 150) if not is_input_active else (0, 255, 255)
    pygame.draw.rect(screen, box_color, input_box_rect, border_radius=4)
    pygame.draw.rect(screen, border_color, input_box_rect, 2, border_radius=4)

    # Render typed text (clip or scroll if too long)
    txt_surf = font.render(sequence_input_str, True, (255, 255, 255))
    screen.blit(txt_surf, (input_box_rect.x + 8, input_box_rect.y + 7))

    pygame.display.flip()

pygame.quit()
sys.exit()
