# Hardware accurate 3-bit VDP to 8-bit standard RGB hex mapping
vdp_to_rgb8 = {
    '0': '00', '2': '20', '4': '40', '6': '60',
    '8': '80', 'A': 'A0', 'C': 'C0', 'E': 'E0'
}

def parse_and_convert(token):
    """Correctly slices tokens into separate R, G, and B components"""
    token = token.upper()
    r = vdp_to_rgb8[token[0]] # Red is 1st digit
    g = vdp_to_rgb8[token[1]] # Green is 2nd digit
    b = vdp_to_rgb8[token[2]] # Blue is 3rd digit
    return f"#{r}{g}{b}"

# Setup Turtle canvas settings
screen = turtle.Screen()
screen.title("Fixed Sega Genesis Color Plotter")
screen.bgcolor("#151515")
screen.setup(width=600, height=950)

t = turtle.Turtle()
t.speed(0)
t.hideturtle()
turtle.tracer(0, 0) 

# Layout constraints
tile_size = 22
padding = 2
line_height = tile_size + padding
start_x = -((8 * (tile_size + padding)) / 2)
current_y = 440

# Process the string line by line
lines = RAW_PALETTE_DATA.strip().split('\n')

for line in lines:
    tokens = line.strip().split()
    
    if not tokens:
        current_y -= 15 # Empty line spacing gap
        continue
        
    current_x = start_x
    for token in tokens:
        if len(token) == 3:
            hex_color = parse_and_convert(token)
            
            t.penup()
            t.goto(current_x, current_y)
            t.pendown()
            
            t.color(hex_color)
            t.begin_fill()
            for _ in range(4):
                t.forward(tile_size)
                t.right(90)
            t.end_fill()
            
            current_x += tile_size + padding
            
    current_y -= line_height

turtle.update()
print("Finished rendering color grid properly!")
turtle.done()

